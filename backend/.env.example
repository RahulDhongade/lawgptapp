# ==========================================
# LawGPT Enterprise Backend Gateway Configuration
# ==========================================

PORT=4000
NODE_ENV=development

# 32+ char secure secret for JWT issuance
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars

# Authorized Web Admin Console origin for CORS
ADMIN_CORS_ORIGIN=http://localhost:5173

# SQLite database file path
DATABASE_PATH=lawgpt_admin.db
