# ==========================================
# LawGPT Mobile Environment Configuration
# ==========================================

# 1. Google Gemini AI Engine (Optional - for ChatGPT-style dynamic chat)
# Get your free key at: https://aistudio.google.com
EXPO_PUBLIC_GEMINI_API_KEY=

# 2. Firebase Authentication (User data & Cloud accounts)
# Get your free keys at: https://console.firebase.google.com
# Step 1: Create project -> Project Settings -> General -> Add Web App (</>)
# Step 2: Enable Authentication -> Sign-in method -> Email/Password
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
