# ==========================================
# LawGPT Git Ignore Specification
# ==========================================

# 1. Dependencies
node_modules/
*/node_modules/
package-lock.json.bak
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 2. Build Outputs & Artifacts
dist/
*/dist/
build/
*/build/
.expo/
.expo-shared/
web-build/

# 3. Environment Secrets & API Credentials
.env
.env*.local
backend/.env
admin ui/.env
*.pem
*.key
*.cert

# 4. Local Database & SQLite WAL Files
*.db
*.db-journal
*.db-wal
*.db-shm
backend/*.db
backend/*.db-wal
backend/*.db-shm
backend/backups/

# 5. Android Build Artifacts
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/*.keystore
android/*.jks
*.apk
*.aab

# 6. iOS Build Artifacts
ios/Pods/
ios/build/
ios/DerivedData/

# 7. IDE & System Files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# 8. Temporary Design Zips & Bundles
*.zip
*.tar.gz
