__d(function(g,r,i,a,m,e,d){var n=r(d[0]);Object.defineProperty(e,"__esModule",{value:!0}),e.legalTemplates=e.getTemplateById=e.buildDraftHtml=void 0;var t=n(r(d[1])),o=n(r(d[2])),s=n(r(d[3])),p=n(r(d[4])),l=n(r(d[5])),c=n(r(d[6])),f=e.legalTemplates=[t.default,o.default,s.default,p.default,l.default,c.default];e.getTemplateById=n=>f.find(t=>t.id===n);e.buildDraftHtml=function(n,t){var o=arguments.length>2&&void 0!==arguments[2]?arguments[2]:'en',s=n.title[o]||n.title.en,p=(new Date).toLocaleDateString('en-IN',{day:'2-digit',month:'long',year:'numeric'}),l='';if('legal-notice'===n.id)l=`\n      <div class="header-box">\n        <p><strong>REGD. POST A.D. / SPEED POST</strong></p>\n        <p>Date: ${p}</p>\n      </div>\n      <div class="recipient-box">\n        <p><strong>TO,</strong><br/>\n        <strong>${t.recipientName||'[Recipient Name]'}</strong><br/>\n        ${(t.recipientAddress||'[Recipient Address]').replace(/\n/g,'<br/>')}</p>\n      </div>\n      <div class="from-box">\n        <p><strong>FROM:</strong><br/>\n        <strong>${t.senderName||'[Sender Name]'}</strong><br/>\n        ${(t.senderAddress||'[Sender Address]').replace(/\n/g,'<br/>')}</p>\n      </div>\n      <div class="subject-line">\n        <strong>SUBJECT: LEGAL NOTICE DEMANDING PAYMENT OF \u20b9${t.claimAmount||'0'} WITHIN ${t.noticePeriodDays||'15'} DAYS</strong>\n      </div>\n      <div class="body-paragraphs">\n        <p>Sir/Madam,</p>\n        <p>Under instructions and authority from my client / on behalf of myself, I hereby serve upon you the following legal notice:</p>\n        <p>1. That the transaction and dispute arose under the following facts and circumstances:</p>\n        <div class="quote-box">${(t.causeOfAction||'').replace(/\n/g,'<br/>')}</div>\n        <p>2. That despite multiple requests, you have failed and neglected to clear the lawful outstanding dues amounting to <strong>\u20b9${t.claimAmount||'0'}</strong>.</p>\n        <p>3. You are hereby called upon to pay the aforesaid outstanding sum of <strong>\u20b9${t.claimAmount||'0'}</strong> within <strong>${t.noticePeriodDays||'15'} days</strong> from the receipt of this notice, failing which appropriate civil and criminal proceedings will be initiated against you before competent courts at your sole risk and costs.</p>\n      </div>\n      <div class="sign-off">\n        <br/><br/>\n        <p>________________________<br/>\n        <strong>${t.senderName||'[Sender Signature]'}</strong><br/>\n        (Sender / Aggrieved Party)</p>\n      </div>\n    `;else if('affidavit'===n.id)l=`\n      <div class="center-heading">\n        <h2>BEFORE THE NOTARY PUBLIC / OATH COMMISSIONER</h2>\n        <h3>AFFIDAVIT</h3>\n      </div>\n      <div class="body-paragraphs">\n        <p>I, <strong>${t.deponentName||'[Deponent Name]'}</strong>, ${t.parentOrSpouseName||''}, aged about <strong>${t.age||'\u2014'} years</strong>, resident of ${(t.residenceAddress||'[Address]').replace(/\n/g,', ')}, do hereby solemnly affirm and declare on oath as under:</p>\n        <p><strong>PURPOSE:</strong> ${t.purpose||'[Purpose]'}</p>\n        <div class="statement-box">\n          ${(t.statements||'').replace(/\n/g,'<br/><br/>')}\n        </div>\n        <br/>\n        <p><strong>VERIFICATION:</strong></p>\n        <p>I, the deponent abovenamed, do hereby verify and declare that the contents of paragraphs above are true and correct to the best of my knowledge and belief, and nothing material has been concealed therefrom.</p>\n        <p>Verified at ____________ on this ${p}.</p>\n      </div>\n      <div class="sign-off">\n        <br/><br/>\n        <p>________________________<br/>\n        <strong>DEPONENT</strong><br/>\n        (${t.deponentName||''})</p>\n      </div>\n    `;else if('rti-application'===n.id)l=`\n      <div class="center-heading">\n        <h2>APPLICATION UNDER SECTION 6(1) OF THE RIGHT TO INFORMATION ACT, 2005</h2>\n        <h3>FORM 'A'</h3>\n      </div>\n      <div class="recipient-box">\n        <p><strong>TO:</strong><br/>\n        ${(t.pioDesignation||'[PIO Designation & Office]').replace(/\n/g,'<br/>')}</p>\n      </div>\n      <div class="body-paragraphs">\n        <p><strong>1. Full Name of the Applicant:</strong> ${t.applicantName||''}</p>\n        <p><strong>2. Address for Correspondence:</strong> ${(t.applicantAddress||'').replace(/\n/g,', ')}</p>\n        <p><strong>3. Contact Details:</strong> ${t.applicantContact||''}</p>\n        <p><strong>4. Citizenship:</strong> Citizen of India</p>\n        <p><strong>5. Particulars of Information Sought:</strong></p>\n        <div class="statement-box">\n          ${(t.particularsOfInfo||'').replace(/\n/g,'<br/>')}\n        </div>\n        <p><strong>6. Fee Payment Details:</strong> ${'yes'===t.bplStatus?'Applicant is Below Poverty Line (BPL Card Attached - Exempt from Fee)':'Application fee of \u20b910 attached via IPO / Court Fee Stamp.'}</p>\n        <p><strong>7. Declaration:</strong> I state that the information sought does not fall within the exemptions contained in Section 8 and 9 of the RTI Act, 2005.</p>\n      </div>\n      <div class="sign-off">\n        <p>Date: ${p}</p>\n        <br/>\n        <p>________________________<br/>\n        <strong>${t.applicantName||'Applicant'}</strong><br/>\n        Signature of Applicant</p>\n      </div>\n    `;else if('rentalAgreement'===n.id)l=`\n      <div class="center-heading">\n        <h2>RESIDENTIAL RENT / LEASE AGREEMENT</h2>\n        <p>(Subject to State Stamp Duty & Registration Laws)</p>\n      </div>\n      <div class="body-paragraphs">\n        <p>This Residential Tenancy Agreement is entered into on this <strong>${t.commencementDate||p}</strong> between:</p>\n        <p><strong>LANDLORD:</strong> <strong>${t.landlordName||'[Landlord Name]'}</strong> (hereinafter called the 'LESSOR') of the FIRST PART;</p>\n        <p><strong>AND</strong></p>\n        <p><strong>TENANT:</strong> <strong>${t.tenantName||'[Tenant Name]'}</strong> (hereinafter called the 'LESSEE') of the SECOND PART.</p>\n        <p><strong>1. PREMISES:</strong> The Lessor hereby lets out and the Lessee takes on rent the residential property located at: <strong>${(t.premisesAddress||'').replace(/\n/g,', ')}</strong>.</p>\n        <p><strong>2. TENURE:</strong> The tenancy shall be for a period of 11 months commencing from <strong>${t.commencementDate||p}</strong> with a lock-in period of <strong>${t.lockInMonths||'0'} months</strong>.</p>\n        <p><strong>3. RENT:</strong> The Lessee agrees to pay a monthly rent of <strong>\u20b9${t.monthlyRent||'0'}</strong> payable in advance on or before the 7th of every calendar month.</p>\n        <p><strong>4. SECURITY DEPOSIT:</strong> The Lessee has paid an interest-free refundable security deposit of <strong>\u20b9${t.securityDeposit||'0'}</strong> to the Lessor.</p>\n      </div>\n      <div class="sign-off">\n        <br/><br/>\n        <table style="width:100%; border:none;">\n          <tr>\n            <td style="width:50%;">____________________<br/><strong>LESSOR (Landlord)</strong></td>\n            <td style="width:50%; text-align:right;">____________________<br/><strong>LESSEE (Tenant)</strong></td>\n          </tr>\n        </table>\n      </div>\n    `;else{var c=n.fields.map(n=>{var s=t[n.id]||'\u2014';return`<div class="field-row"><strong>${n.label[o]||n.label.en}:</strong><br/>${String(s).replace(/\n/g,'<br/>')}</div>`}).join('');l=`\n      <div class="center-heading">\n        <h2>${s.toUpperCase()}</h2>\n        <p>Date of Draft: ${p}</p>\n      </div>\n      <div class="body-paragraphs">\n        ${c}\n      </div>\n      <div class="sign-off">\n        <br/><br/>\n        <p>________________________<br/>\n        <strong>Authorized Signatory / Applicant</strong></p>\n      </div>\n    `}var f=n.stateStampDutyNote?`<div class="stamp-note"><strong>STATE STAMP DUTY NOTICE:</strong> ${n.stateStampDutyNote}</div>`:'';return`\n    <!DOCTYPE html>\n    <html lang="${o}">\n    <head>\n      <meta charset="utf-8">\n      <title>${s}</title>\n      <style>\n        @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;600;700&family=Inter:wght@400;500;600;700&display=swap');\n        \n        @page {\n          size: A4;\n          margin: 20mm;\n        }\n\n        body {\n          font-family: 'Noto Sans Devanagari', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\n          color: #1a1a1a;\n          background-color: #ffffff;\n          line-height: 1.6;\n          font-size: 13pt;\n          padding: 24px;\n          position: relative;\n        }\n\n        /* Diagonal DRAFT Watermark */\n        .watermark {\n          position: fixed;\n          top: 35%;\n          left: 10%;\n          width: 80%;\n          text-align: center;\n          font-size: 90pt;\n          font-weight: 800;\n          color: rgba(200, 30, 30, 0.12);\n          transform: rotate(-35deg);\n          pointer-events: none;\n          z-index: 1000;\n          letter-spacing: 12px;\n          text-transform: uppercase;\n          font-family: 'Inter', sans-serif;\n        }\n\n        .disclaimer-banner {\n          background-color: #fef3c7;\n          border-left: 4px solid #f59e0b;\n          color: #92400e;\n          padding: 10px 14px;\n          font-size: 10pt;\n          margin-bottom: 20px;\n          border-radius: 4px;\n        }\n\n        .stamp-note {\n          background-color: #eff6ff;\n          border-left: 4px solid #3b82f6;\n          color: #1e40af;\n          padding: 8px 12px;\n          font-size: 9.5pt;\n          margin-bottom: 16px;\n          border-radius: 4px;\n        }\n\n        .center-heading {\n          text-align: center;\n          margin-bottom: 24px;\n        }\n\n        .center-heading h2 {\n          margin: 0;\n          font-size: 16pt;\n          font-weight: 700;\n          color: #111827;\n        }\n\n        .center-heading h3 {\n          margin: 4px 0 0 0;\n          font-size: 13pt;\n          font-weight: 600;\n          color: #374151;\n        }\n\n        .header-box {\n          text-align: right;\n          margin-bottom: 16px;\n        }\n\n        .recipient-box, .from-box {\n          margin-bottom: 16px;\n        }\n\n        .subject-line {\n          text-decoration: underline;\n          margin: 20px 0;\n          font-size: 13pt;\n          line-height: 1.5;\n        }\n\n        .quote-box {\n          background: #f9fafb;\n          border-left: 3px solid #9ca3af;\n          padding: 10px 14px;\n          margin: 12px 0;\n          font-style: italic;\n        }\n\n        .statement-box {\n          background: #f9fafb;\n          padding: 12px 16px;\n          border-radius: 6px;\n          margin: 12px 0;\n        }\n\n        .field-row {\n          margin-bottom: 14px;\n          padding-bottom: 8px;\n          border-bottom: 1px dashed #e5e7eb;\n        }\n\n        .sign-off {\n          margin-top: 36px;\n          page-break-inside: avoid;\n        }\n\n        .footer-statutory {\n          margin-top: 40px;\n          padding-top: 12px;\n          border-top: 1px solid #d1d5db;\n          font-size: 8.5pt;\n          color: #6b7280;\n          text-align: center;\n        }\n      </style>\n    </head>\n    <body>\n      <div class="watermark">DRAFT</div>\n\n      <div class="disclaimer-banner">\n        <strong>DRAFT \u2013 REVIEW BEFORE USE:</strong> This automated draft is prepared for reference purposes by LawGPT. It does not constitute formal legal representation under the Advocates Act, 1961. Review with a qualified lawyer before execution.\n      </div>\n\n      ${f}\n\n      ${l}\n\n      <div class="footer-statutory">\n        Generated via LawGPT \u2013 India's AI Legal Assistant \u2022 Verified against Indian Statutory Standards \u2022 Source: ${n.source}\n      </div>\n    </body>\n    </html>\n  `}},2549,[1,2550,2551,2552,2553,2554,2555]);
__d(function(e,i,a,r,t,n,l){t.exports={id:"legal-notice",title:{en:"Legal Notice for Recovery / Breach",hi:"\u0935\u0938\u0942\u0932\u0940 / \u0905\u0928\u0941\u092c\u0902\u0927 \u0909\u0932\u094d\u0932\u0902\u0918\u0928 \u0939\u0947\u0924\u0941 \u0915\u093e\u0928\u0942\u0928\u0940 \u0928\u094b\u091f\u093f\u0938",mr:"\u0935\u0938\u0941\u0932\u0940 / \u0915\u0930\u093e\u0930 \u092d\u0902\u0917\u093e\u092c\u093e\u092c\u0924 \u0915\u093e\u092f\u0926\u0947\u0936\u0940\u0930 \u0928\u094b\u091f\u0940\u0938"},description:{en:"Formal legal notice demanding payment of unpaid dues or remedy for contractual breach.",hi:"\u092c\u0915\u093e\u092f\u093e \u0930\u093e\u0936\u093f \u0915\u0940 \u092e\u093e\u0902\u0917 \u092f\u093e \u0938\u0902\u0935\u093f\u0926\u093e \u0909\u0932\u094d\u0932\u0902\u0918\u0928 \u0915\u0947 \u0938\u092e\u093e\u0927\u093e\u0928 \u0939\u0947\u0924\u0941 \u0914\u092a\u091a\u093e\u0930\u093f\u0915 \u0915\u093e\u0928\u0942\u0928\u0940 \u0928\u094b\u091f\u093f\u0938\u0964",mr:"\u0925\u0915\u0940\u0924 \u0930\u0915\u094d\u0915\u092e \u092e\u093f\u0933\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u093f\u0902\u0935\u093e \u0915\u0930\u093e\u0930\u093e\u091a\u094d\u092f\u093e \u0909\u0932\u094d\u0932\u0902\u0918\u0928\u093e\u0938\u093e\u0920\u0940 \u0914\u092a\u091a\u093e\u0930\u093f\u0915 \u0915\u093e\u092f\u0926\u0947\u0936\u0940\u0930 \u0928\u094b\u091f\u0940\u0938."},category:"Civil & Commercial",source:"Standard Legal Drafting Practice, Bar Council of India guidelines",lastUpdated:"2024-07-01",reviewStatus:"UNREVIEWED",todo:"TODO: Requires advocate review and dispatch via Registered Post A.D. before judicial filing.",fields:[{id:"senderName",label:{en:"Sender Full Name (Your Name)",hi:"\u092a\u094d\u0930\u0947\u0937\u0915 \u0915\u093e \u092a\u0942\u0930\u093e \u0928\u093e\u092e (\u0906\u092a\u0915\u093e \u0928\u093e\u092e)",mr:"\u092a\u093e\u0920\u0935\u093f\u0923\u093e\u0931\u094d\u092f\u093e\u091a\u0947 \u092a\u0942\u0930\u094d\u0923 \u0928\u093e\u0935"},placeholder:{en:"e.g. Ramesh Kumar Sharma",hi:"\u0909\u0926\u093e. \u0930\u092e\u0947\u0936 \u0915\u0941\u092e\u093e\u0930 \u0936\u0930\u094d\u092e\u093e",mr:"\u0909\u0926\u093e. \u0930\u092e\u0947\u0936 \u0915\u0941\u092e\u093e\u0930 \u0936\u0930\u094d\u092e\u093e"},helperText:{en:"The aggrieved party issuing this notice.",hi:"\u0928\u094b\u091f\u093f\u0938 \u091c\u093e\u0930\u0940 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u093e \u092a\u0940\u0921\u093c\u093f\u0924 \u092a\u0915\u094d\u0937\u0964",mr:"\u0928\u094b\u091f\u0940\u0938 \u092c\u091c\u093e\u0935\u0923\u093e\u0930\u093e \u0924\u0915\u094d\u0930\u093e\u0930\u0926\u093e\u0930."},type:"text",required:!0,validation:{minLength:3,maxLength:100}},{id:"senderAddress",label:{en:"Sender Complete Address",hi:"\u092a\u094d\u0930\u0947\u0937\u0915 \u0915\u093e \u092a\u0942\u0930\u093e \u092a\u0924\u093e",mr:"\u092a\u093e\u0920\u0935\u093f\u0923\u093e\u0931\u094d\u092f\u093e\u091a\u093e \u0938\u0902\u092a\u0942\u0930\u094d\u0923 \u092a\u0924\u094d\u0924\u093e"},placeholder:{en:"e.g. Flat 402, Shanti Vihar, New Delhi - 110001",hi:"\u0909\u0926\u093e. \u092b\u094d\u0932\u0948\u091f 402, \u0936\u093e\u0902\u0924\u093f \u0935\u093f\u0939\u093e\u0930, \u0928\u0908 \u0926\u093f\u0932\u094d\u0932\u0940 - 110001",mr:"\u0909\u0926\u093e. \u092b\u094d\u0932\u0945\u091f \u096a\u0966\u0968, \u0936\u093e\u0902\u0924\u0940 \u0935\u093f\u0939\u093e\u0930, \u092a\u0941\u0923\u0947 - \u096a\u0967\u0967\u0966\u0969\u096e"},helperText:{en:"Postal communication address.",hi:"\u0921\u093e\u0915 \u092a\u0924\u094d\u0930\u093e\u091a\u093e\u0930 \u0915\u093e \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u092a\u0924\u093e\u0964",mr:"\u092a\u0924\u094d\u0930\u0935\u094d\u092f\u0935\u0939\u093e\u0930\u093e\u091a\u093e \u092a\u0924\u094d\u0924\u093e."},type:"textarea",required:!0,validation:{minLength:10,maxLength:200}},{id:"recipientName",label:{en:"Recipient / Defaulter Name",hi:"\u092a\u094d\u0930\u093e\u092a\u094d\u0924\u0915\u0930\u094d\u0924\u093e / \u092c\u0915\u093e\u090f\u0926\u093e\u0930 \u0915\u093e \u0928\u093e\u092e",mr:"\u091c\u094d\u092f\u093e\u0932\u093e \u0928\u094b\u091f\u0940\u0938 \u0926\u094d\u092f\u093e\u092f\u091a\u0940 \u0924\u094d\u092f\u093e\u091a\u0947 \u0928\u093e\u0935"},placeholder:{en:"e.g. Arvind Mehta (Director, ABC Retail Pvt Ltd)",hi:"\u0909\u0926\u093e. \u0905\u0930\u0935\u093f\u0902\u0926 \u092e\u0947\u0939\u0924\u093e",mr:"\u0909\u0926\u093e. \u0905\u0930\u0935\u093f\u0902\u0926 \u092e\u0947\u0939\u0924\u093e"},helperText:{en:"Name of the individual or company in breach.",hi:"\u0909\u0932\u094d\u0932\u0902\u0918\u0928 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u092f\u093e \u092b\u0930\u094d\u092e \u0915\u093e \u0928\u093e\u092e\u0964",mr:"\u0915\u0930\u093e\u0930 \u092e\u094b\u0921\u0923\u093e\u0931\u094d\u092f\u093e \u0935\u094d\u092f\u0915\u094d\u0924\u0940\u091a\u0947 \u0915\u093f\u0902\u0935\u093e \u0938\u0902\u0938\u094d\u0925\u0947\u091a\u0947 \u0928\u093e\u0935."},type:"text",required:!0,validation:{minLength:3,maxLength:100}},{id:"recipientAddress",label:{en:"Recipient Complete Address",hi:"\u092a\u094d\u0930\u093e\u092a\u094d\u0924\u0915\u0930\u094d\u0924\u093e \u0915\u093e \u092a\u0942\u0930\u093e \u092a\u0924\u093e",mr:"\u092a\u094d\u0930\u093e\u092a\u094d\u0924\u0915\u0930\u094d\u0924\u094d\u092f\u093e\u091a\u093e \u0938\u0902\u092a\u0942\u0930\u094d\u0923 \u092a\u0924\u094d\u0924\u093e"},placeholder:{en:"e.g. 12, Commercial Complex, MG Road, Mumbai - 400001",hi:"\u0909\u0926\u093e. 12, \u0915\u092e\u0930\u094d\u0936\u093f\u092f\u0932 \u0915\u0949\u092e\u094d\u092a\u094d\u0932\u0947\u0915\u094d\u0938, \u090f\u092e\u091c\u0940 \u0930\u094b\u0921, \u092e\u0941\u0902\u092c\u0908",mr:"\u0909\u0926\u093e. \u0967\u0968, \u0935\u094d\u092f\u093e\u0935\u0938\u093e\u092f\u093f\u0915 \u0938\u0902\u0915\u0941\u0932, \u090f\u092e\u091c\u0940 \u0930\u094b\u0921, \u092e\u0941\u0902\u092c\u0908"},helperText:{en:"Address where registered notice will be served.",hi:"\u0935\u0939 \u092a\u0924\u093e \u091c\u0939\u093e\u0902 \u0928\u094b\u091f\u093f\u0938 \u092d\u0947\u091c\u093e \u091c\u093e\u090f\u0917\u093e\u0964",mr:"\u0928\u094b\u091f\u0940\u0938 \u092a\u093e\u0920\u0935\u0923\u094d\u092f\u093e\u091a\u093e \u092a\u0924\u094d\u0924\u093e."},type:"textarea",required:!0,validation:{minLength:10,maxLength:200}},{id:"claimAmount",label:{en:"Claim Amount (in INR \u20b9)",hi:"\u0926\u093e\u0935\u093e \u0915\u0940 \u0917\u0908 \u0930\u093e\u0936\u093f (\u0930\u0941\u092a\u092f\u0947 \u20b9 \u092e\u0947\u0902)",mr:"\u0926\u093e\u0935\u093e \u0915\u0947\u0932\u0947\u0932\u0940 \u0930\u0915\u094d\u0915\u092e (\u0930\u0941\u092a\u092f\u0947 \u20b9)"},placeholder:{en:"e.g. 75,000",hi:"\u0909\u0926\u093e. 75000",mr:"\u0909\u0926\u093e. \u096d\u096b\u0966\u0966\u0966"},helperText:{en:"Principal pending amount.",hi:"\u092e\u0942\u0932 \u092c\u0915\u093e\u092f\u093e \u0930\u093e\u0936\u093f\u0964",mr:"\u0925\u0915\u0940\u0924 \u092e\u0942\u0933 \u0930\u0915\u094d\u0915\u092e."},type:"number",required:!0,validation:{min:1}},{id:"noticePeriodDays",label:{en:"Notice Period (Days to Comply)",hi:"\u0928\u094b\u091f\u093f\u0938 \u0905\u0935\u0927\u093f (\u092d\u0941\u0917\u0924\u093e\u0928 \u0939\u0947\u0924\u0941 \u0926\u093f\u090f \u0917\u090f \u0926\u093f\u0928)",mr:"\u0928\u094b\u091f\u0940\u0938 \u0915\u093e\u0932\u093e\u0935\u0927\u0940 (\u0926\u093f\u0935\u0938)"},placeholder:{en:"15",hi:"15",mr:"\u0967\u096b"},helperText:{en:"Standard duration is usually 15 or 30 days.",hi:"\u092e\u093e\u0928\u0915 \u0905\u0935\u0927\u093f \u0906\u092e\u0924\u094c\u0930 \u092a\u0930 15 \u092f\u093e 30 \u0926\u093f\u0928 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964",mr:"\u0938\u0939\u0938\u093e \u0967\u096b \u0915\u093f\u0902\u0935\u093e \u0969\u0966 \u0926\u093f\u0935\u0938\u093e\u0902\u091a\u0940 \u092e\u0941\u0926\u0924 \u0926\u093f\u0932\u0940 \u091c\u093e\u0924\u0947."},type:"select",required:!0,options:[{value:"15",label:{en:"15 Days",hi:"15 \u0926\u093f\u0928",mr:"\u0967\u096b \u0926\u093f\u0935\u0938"}},{value:"30",label:{en:"30 Days",hi:"30 \u0926\u093f\u0928",mr:"\u0969\u0966 \u0926\u093f\u0935\u0938"}}]},{id:"causeOfAction",label:{en:"Summary of Dispute & Facts",hi:"\u0935\u093f\u0935\u093e\u0926 \u090f\u0935\u0902 \u0924\u0925\u094d\u092f\u094b\u0902 \u0915\u093e \u0938\u0902\u0915\u094d\u0937\u093f\u092a\u094d\u0924 \u0935\u093f\u0935\u0930\u0923",mr:"\u0924\u0915\u094d\u0930\u093e\u0930\u0940\u091a\u093e \u0924\u092a\u0936\u0940\u0932 \u0906\u0923\u093f \u0935\u0938\u094d\u0924\u0941\u0938\u094d\u0925\u093f\u0924\u0940"},placeholder:{en:"Goods supplied on 12th Jan against Invoice #102, payment cheque bounced due to insufficient funds.",hi:"\u0938\u093e\u092e\u093e\u0928 \u0915\u0940 \u0906\u092a\u0942\u0930\u094d\u0924\u093f \u0915\u0940 \u0917\u0908 \u0925\u0940, \u0932\u0947\u0915\u093f\u0928 \u091c\u093e\u0930\u0940 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u091a\u0947\u0915 \u0905\u092a\u0930\u094d\u092f\u093e\u092a\u094d\u0924 \u0928\u093f\u0927\u093f \u0915\u0947 \u0915\u093e\u0930\u0923 \u0905\u0928\u093e\u0926\u0930\u093f\u0924 \u0939\u094b \u0917\u092f\u093e\u0964",mr:"\u092e\u093e\u0932 \u092a\u0941\u0930\u0935\u0932\u093e \u0939\u094b\u0924\u093e \u092a\u0930\u0902\u0924\u0941 \u0926\u093f\u0932\u0947\u0932\u093e \u0927\u0928\u093e\u0926\u0947\u0936 \u092c\u0901\u0915\u0947\u0924 \u0935\u091f\u0932\u093e \u0928\u093e\u0939\u0940."},helperText:{en:"State dates, invoice or contract reference, and default description clearly.",hi:"\u0924\u093e\u0930\u0940\u0916, \u0907\u0928\u0935\u0949\u0907\u0938 \u092f\u093e \u0905\u0928\u0941\u092c\u0902\u0927 \u0915\u093e \u0938\u0902\u0926\u0930\u094d\u092d \u0938\u094d\u092a\u0937\u094d\u091f \u0930\u0942\u092a \u0938\u0947 \u0932\u093f\u0916\u0947\u0902\u0964",mr:"\u0924\u093e\u0930\u0940\u0916, \u0926\u0947\u092f\u0915 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0906\u0923\u093f \u0915\u0930\u093e\u0930\u093e\u091a\u093e \u0924\u092a\u0936\u0940\u0932 \u0938\u094d\u092a\u0937\u094d\u091f \u0932\u093f\u0939\u093e."},type:"textarea",required:!0,validation:{minLength:20,maxLength:1e3}}]}},2550,[]);
__d(function(e,a,t,r,i,n,o){i.exports={id:"affidavit",title:{en:"General Sworn Affidavit",hi:"\u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0936\u092a\u0925 \u092a\u0924\u094d\u0930 (\u0939\u0932\u092b\u0928\u093e\u092e\u093e)",mr:"\u0938\u0930\u094d\u0935\u0938\u093e\u0927\u093e\u0930\u0923 \u092a\u094d\u0930\u0924\u093f\u091c\u094d\u091e\u093e\u092a\u0924\u094d\u0930 (\u0936\u092a\u0925\u092a\u0924\u094d\u0930)"},description:{en:"Standard sworn statement of facts on non-judicial stamp paper attested before Notary or Oath Commissioner.",hi:"\u0928\u094b\u091f\u0930\u0940 \u092f\u093e \u0936\u092a\u0925 \u0906\u092f\u0941\u0915\u094d\u0924 \u0915\u0947 \u0938\u092e\u0915\u094d\u0937 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0924\u0925\u094d\u092f\u094b\u0902 \u0915\u093e \u092e\u093e\u0928\u0915 \u0936\u092a\u0925 \u092a\u0924\u094d\u0930\u0964",mr:"\u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924 \u0928\u094b\u091f\u0930\u0940 \u0915\u093f\u0902\u0935\u093e \u0926\u0902\u0921\u093e\u0927\u093f\u0915\u093e\u0931\u094d\u092f\u093e\u0902\u0938\u092e\u094b\u0930 \u0938\u0924\u094d\u092f\u0915\u0925\u0928 \u0915\u0930\u0923\u093e\u0930\u0947 \u0915\u093e\u092f\u0926\u0947\u0936\u0940\u0930 \u092a\u094d\u0930\u0924\u093f\u091c\u094d\u091e\u093e\u092a\u0924\u094d\u0930."},category:"Civil & Declarations",source:"Oaths Act, 1969 & High Court Rules",lastUpdated:"2024-07-01",reviewStatus:"UNREVIEWED",stateStampDutyNote:"Stamp duty rates and stamp paper denomination vary by State (e.g. \u20b910 in Delhi, \u20b9100 in UP, \u20b9500 in Maharashtra). Must be printed on non-judicial stamp paper and attested by a Notary Public.",todo:"TODO: Requires advocate review, execution on non-judicial stamp paper, and notarization.",fields:[{id:"deponentName",label:{en:"Deponent Name (Your Full Name)",hi:"\u0936\u092a\u0925\u0915\u0930\u094d\u0924\u093e \u0915\u093e \u0928\u093e\u092e (\u0906\u092a\u0915\u093e \u092a\u0942\u0930\u093e \u0928\u093e\u092e)",mr:"\u092a\u094d\u0930\u0924\u093f\u091c\u094d\u091e\u093e\u092a\u0924\u094d\u0930\u093e\u0924\u0940\u0932 \u0905\u0930\u094d\u091c\u0926\u093e\u0930\u093e\u091a\u0947 \u092a\u0942\u0930\u094d\u0923 \u0928\u093e\u0935"},placeholder:{en:"e.g. Sunita Devi",hi:"\u0909\u0926\u093e. \u0938\u0941\u0928\u0940\u0924\u093e \u0926\u0947\u0935\u0940",mr:"\u0909\u0926\u093e. \u0938\u0941\u0928\u093f\u0924\u093e \u0926\u0947\u0935\u0940"},helperText:{en:"Person declaring statements under oath.",hi:"\u0936\u092a\u0925 \u0932\u0947\u0915\u0930 \u092c\u092f\u093e\u0928 \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u093e \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0964",mr:"\u0936\u092a\u0925\u0947\u0935\u0930 \u0938\u0924\u094d\u092f\u0915\u0925\u0928 \u0915\u0930\u0923\u093e\u0930\u0940 \u0935\u094d\u092f\u0915\u094d\u0924\u0940."},type:"text",required:!0,validation:{minLength:3,maxLength:100}},{id:"parentOrSpouseName",label:{en:"Father's / Mother's / Spouse's Name",hi:"\u092a\u093f\u0924\u093e / \u092e\u093e\u0924\u093e / \u092a\u0924\u093f \u0915\u093e \u0928\u093e\u092e",mr:"\u0935\u0921\u0940\u0932 / \u0906\u0908 / \u092a\u0924\u0940\u091a\u0947 \u0928\u093e\u0935"},placeholder:{en:"e.g. D/o Late Shri Ram Prakash",hi:"\u0909\u0926\u093e. \u092a\u0941\u0924\u094d\u0930\u0940 \u0938\u094d\u0935. \u0936\u094d\u0930\u0940 \u0930\u093e\u092e \u092a\u094d\u0930\u0915\u093e\u0936",mr:"\u0909\u0926\u093e. \u0938\u094d\u0935. \u0930\u093e\u092e \u092a\u094d\u0930\u0915\u093e\u0936 \u092f\u093e\u0902\u091a\u0940 \u0915\u0928\u094d\u092f\u093e"},helperText:{en:"Parentage or spousal relation for legal identification.",hi:"\u092a\u0939\u091a\u093e\u0928 \u0939\u0947\u0924\u0941 \u0905\u092d\u093f\u092d\u093e\u0935\u0915 \u092f\u093e \u092a\u0924\u093f \u0915\u093e \u0928\u093e\u092e\u0964",mr:"\u0913\u0933\u0916\u0940\u0938\u093e\u0920\u0940 \u092a\u093e\u0932\u0915 \u0915\u093f\u0902\u0935\u093e \u091c\u094b\u0921\u0940\u0926\u093e\u0930\u093e\u091a\u0947 \u0928\u093e\u0935."},type:"text",required:!0,validation:{minLength:3,maxLength:100}},{id:"age",label:{en:"Age (Years)",hi:"\u0909\u092e\u094d\u0930 (\u0935\u0930\u094d\u0937)",mr:"\u0935\u092f (\u0935\u0930\u094d\u0937\u0947)"},placeholder:{en:"e.g. 34",hi:"\u0909\u0926\u093e. 34",mr:"\u0909\u0926\u093e. \u0969\u096a"},helperText:{en:"Deponent must be major (18+ years).",hi:"\u0936\u092a\u0925\u0915\u0930\u094d\u0924\u093e \u092c\u093e\u0932\u093f\u0917 (18 \u0935\u0930\u094d\u0937 \u0938\u0947 \u0905\u0927\u093f\u0915) \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964",mr:"\u0935\u092f \u0967\u096e \u0935\u0930\u094d\u0937\u093e\u0902\u092a\u0947\u0915\u094d\u0937\u093e \u091c\u093e\u0938\u094d\u0924 \u0905\u0938\u093e\u0935\u0947."},type:"number",required:!0,validation:{min:18}},{id:"residenceAddress",label:{en:"Permanent / Residential Address",hi:"\u0938\u094d\u0925\u093e\u092f\u0940 / \u0928\u093f\u0935\u093e\u0938 \u0915\u093e \u092a\u0924\u093e",mr:"\u0915\u093e\u092f\u092e\u091a\u093e / \u0938\u0927\u094d\u092f\u093e\u091a\u093e \u092a\u0924\u094d\u0924\u093e"},placeholder:{en:"e.g. House No. 55, Sector 14, Gurugram, Haryana - 122001",hi:"\u0909\u0926\u093e. \u092e\u0915\u093e\u0928 \u0928\u0902. 55, \u0938\u0947\u0915\u094d\u091f\u0930 14, \u0917\u0941\u0930\u0941\u0917\u094d\u0930\u093e\u092e",mr:"\u0909\u0926\u093e. \u0918\u0930 \u0915\u094d\u0930. \u096b\u096b, \u0938\u0947\u0915\u094d\u091f\u0930 \u0967\u096a, \u092a\u0941\u0923\u0947"},helperText:{en:"Complete residential address as per Aadhaar/Voter ID.",hi:"\u092a\u0939\u091a\u093e\u0928 \u092a\u0924\u094d\u0930 \u0905\u0928\u0941\u0938\u093e\u0930 \u092a\u0942\u0930\u093e \u092a\u0924\u093e\u0964",mr:"\u0913\u0933\u0916\u092a\u0924\u094d\u0930\u093e\u0935\u0930\u0940\u0932 \u092a\u0942\u0930\u094d\u0923 \u092a\u0924\u094d\u0924\u093e."},type:"textarea",required:!0,validation:{minLength:10,maxLength:200}},{id:"purpose",label:{en:"Purpose of Affidavit",hi:"\u0936\u092a\u0925 \u092a\u0924\u094d\u0930 \u0915\u093e \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f",mr:"\u092a\u094d\u0930\u0924\u093f\u091c\u094d\u091e\u093e\u092a\u0924\u094d\u0930\u093e\u091a\u0947 \u092a\u094d\u0930\u092f\u094b\u091c\u0928"},placeholder:{en:"e.g. Name change / Address proof / Loss of original certificate",hi:"\u0909\u0926\u093e. \u0928\u093e\u092e \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 / \u092a\u0924\u0947 \u0915\u093e \u092a\u094d\u0930\u092e\u093e\u0923 / \u092a\u094d\u0930\u092e\u093e\u0923 \u092a\u0924\u094d\u0930 \u0917\u0941\u092e \u0939\u094b\u0928\u093e",mr:"\u0909\u0926\u093e. \u0928\u093e\u0935\u093e\u0924 \u092c\u0926\u0932 / \u092a\u0924\u094d\u0924\u094d\u092f\u093e\u091a\u093e \u092a\u0941\u0930\u093e\u0935\u093e / \u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930 \u0917\u0939\u093e\u0933"},helperText:{en:"Authority or agency to which affidavit is submitted.",hi:"\u0935\u093f\u092d\u093e\u0917 \u092f\u093e \u0938\u0902\u0938\u094d\u0925\u093e \u091c\u093f\u0938\u0915\u0947 \u0938\u092e\u0915\u094d\u0937 \u0936\u092a\u0925 \u092a\u0924\u094d\u0930 \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964",mr:"\u091c\u094d\u092f\u093e \u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f\u093e\u0924 \u0938\u093e\u0926\u0930 \u0915\u0930\u093e\u092f\u091a\u0947 \u0906\u0939\u0947 \u0924\u094d\u092f\u093e\u091a\u093e \u0938\u0902\u0926\u0930\u094d\u092d."},type:"text",required:!0,validation:{minLength:5,maxLength:100}},{id:"statements",label:{en:"Facts Declared Under Oath (Numbered points)",hi:"\u0936\u092a\u0925 \u092a\u0942\u0930\u094d\u0935\u0915 \u0918\u094b\u0937\u093f\u0924 \u0924\u0925\u094d\u092f (\u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0935\u093e\u0930 \u092c\u093f\u0902\u0926\u0941)",mr:"\u0936\u092a\u0925\u0947\u0935\u0930 \u091c\u093e\u0939\u0940\u0930 \u0915\u0947\u0932\u0947\u0932\u0947 \u092e\u0941\u0926\u094d\u0926\u0947 (\u0915\u094d\u0930\u092e\u093e\u0902\u0915\u093e\u0928\u0941\u0938\u093e\u0930)"},placeholder:{en:"1. That my actual name is Sunita Devi as per Matriculation.\n2. That in my PAN card my name was erroneously printed as Sunita.\n3. That Sunita and Sunita Devi are one and the same person.",hi:"1. \u0915\u093f \u092e\u0947\u0930\u093e \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u0928\u093e\u092e \u0938\u0941\u0928\u0940\u0924\u093e \u0926\u0947\u0935\u0940 \u0939\u0948\u0964\n2. \u0915\u093f \u092a\u0948\u0928 \u0915\u093e\u0930\u094d\u0921 \u092e\u0947\u0902 \u092d\u0942\u0932\u0935\u0936 \u0915\u0947\u0935\u0932 \u0938\u0941\u0928\u0940\u0924\u093e \u0926\u0930\u094d\u091c \u0939\u094b \u0917\u092f\u093e \u0925\u093e\u0964\n3. \u0915\u093f \u0926\u094b\u0928\u094b\u0902 \u090f\u0915 \u0939\u0940 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0939\u0948\u0902\u0964",mr:"\u0967. \u092e\u093e\u091d\u0947 \u0928\u093e\u0935 \u0938\u0941\u0928\u093f\u0924\u093e \u0926\u0947\u0935\u0940 \u0906\u0939\u0947.\n\u0968. \u092a\u0945\u0928 \u0915\u093e\u0930\u094d\u0921\u0935\u0930 \u0928\u091c\u0930\u091a\u0941\u0915\u0940\u0928\u0947 \u0938\u0941\u0928\u093f\u0924\u093e \u0905\u0938\u0947 \u0928\u094b\u0902\u0926\u0935\u0932\u0947 \u0917\u0947\u0932\u0947 \u0906\u0939\u0947.\n\u0969. \u0926\u094b\u0928\u094d\u0939\u0940 \u0928\u093e\u0935\u0947 \u090f\u0915\u093e\u091a \u0935\u094d\u092f\u0915\u094d\u0924\u0940\u091a\u0940 \u0906\u0939\u0947\u0924."},helperText:{en:"Provide truth statements verified to best of your knowledge.",hi:"\u0905\u092a\u0928\u0940 \u0938\u091a\u094d\u091a\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0915\u094d\u0930\u092e\u092c\u0926\u094d\u0927 \u0924\u0925\u094d\u092f \u0932\u093f\u0916\u0947\u0902\u0964",mr:"\u0938\u0924\u094d\u092f \u0905\u0938\u0932\u0947\u0932\u0947 \u092e\u0941\u0926\u094d\u0926\u0947 \u0938\u094d\u092a\u0937\u094d\u091f\u092a\u0923\u0947 \u0932\u093f\u0939\u093e."},type:"textarea",required:!0,validation:{minLength:20,maxLength:1500}}]}},2551,[]);
__d(function(e,i,t,n,a,r,o){a.exports={id:"rti-application",title:{en:"RTI Application (Form A)",hi:"\u0938\u0942\u091a\u0928\u093e \u0915\u093e \u0905\u0927\u093f\u0915\u093e\u0930 \u0906\u0935\u0947\u0926\u0928 (\u092a\u094d\u0930\u092a\u0924\u094d\u0930 \u0915)",mr:"\u092e\u093e\u0939\u093f\u0924\u0940 \u0905\u0927\u093f\u0915\u093e\u0930 \u0905\u0930\u094d\u091c (\u0928\u092e\u0941\u0928\u093e \u0905)"},description:{en:"Statutory application under Section 6(1) of the Right to Information Act, 2005 to Public Information Officer (PIO).",hi:"\u0938\u0942\u091a\u0928\u093e \u0915\u093e \u0905\u0927\u093f\u0915\u093e\u0930 \u0905\u0927\u093f\u0928\u093f\u092f\u092e, 2005 \u0915\u0940 \u0927\u093e\u0930\u093e 6(1) \u0915\u0947 \u0924\u0939\u0924 \u091c\u0928 \u0938\u0942\u091a\u0928\u093e \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u0915\u094b \u0914\u092a\u091a\u093e\u0930\u093f\u0915 \u0906\u0935\u0947\u0926\u0928\u0964",mr:"\u092e\u093e\u0939\u093f\u0924\u0940\u091a\u093e \u0905\u0927\u093f\u0915\u093e\u0930 \u0905\u0927\u093f\u0928\u093f\u092f\u092e, \u0968\u0966\u0966\u096b \u091a\u094d\u092f\u093e \u0915\u0932\u092e \u096c(\u0967) \u0905\u0928\u094d\u0935\u092f\u0947 \u091c\u0928 \u092e\u093e\u0939\u093f\u0924\u0940 \u0905\u0927\u093f\u0915\u093e\u0931\u094d\u092f\u093e\u0938 \u0926\u094d\u092f\u093e\u092f\u091a\u093e \u0905\u0930\u094d\u091c."},category:"Statutory Rights & Governance",source:"Right to Information Act, 2005 (Act No. 22 of 2005)",lastUpdated:"2024-07-01",reviewStatus:"UNREVIEWED",todo:"TODO: Requires verification of application fee (typically \u20b910 via IPO/Court Fee Stamp) and appropriate Public Authority designation.",fields:[{id:"pioDesignation",label:{en:"Public Information Officer Designation & Office",hi:"\u091c\u0928 \u0938\u0942\u091a\u0928\u093e \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u0915\u093e \u092a\u0926\u0928\u093e\u092e \u090f\u0935\u0902 \u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f",mr:"\u091c\u0928 \u092e\u093e\u0939\u093f\u0924\u0940 \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u092a\u0926 \u0906\u0923\u093f \u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f"},placeholder:{en:"The Public Information Officer, Municipal Corporation of Greater Mumbai, Fort, Mumbai",hi:"\u091c\u0928 \u0938\u0942\u091a\u0928\u093e \u0905\u0927\u093f\u0915\u093e\u0930\u0940, \u0928\u0917\u0930 \u0928\u093f\u0917\u092e, \u0938\u093f\u0935\u093f\u0932 \u0932\u093e\u0907\u0902\u0938",mr:"\u091c\u0928 \u092e\u093e\u0939\u093f\u0924\u0940 \u0905\u0927\u093f\u0915\u093e\u0930\u0940, \u092e\u0939\u093e\u0928\u0917\u0930\u092a\u093e\u0932\u093f\u0915\u093e \u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f"},helperText:{en:"Public Authority holding the records requested.",hi:"\u0935\u0939 \u0938\u093e\u0930\u094d\u0935\u091c\u0928\u093f\u0915 \u092a\u094d\u0930\u093e\u0927\u093f\u0915\u0930\u0923 \u091c\u093f\u0938\u0915\u0947 \u092a\u093e\u0938 \u092e\u093e\u0902\u0917\u0940 \u0917\u0908 \u0938\u0942\u091a\u0928\u093e \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u0948\u0964",mr:"\u091c\u094d\u092f\u093e \u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f\u093e\u0915\u0921\u0947 \u092e\u093e\u0939\u093f\u0924\u0940 \u0909\u092a\u0932\u092c\u094d\u0927 \u0906\u0939\u0947 \u0924\u0947 \u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f."},type:"textarea",required:!0,validation:{minLength:10,maxLength:200}},{id:"applicantName",label:{en:"Applicant Full Name",hi:"\u0906\u0935\u0947\u0926\u0915 \u0915\u093e \u092a\u0942\u0930\u093e \u0928\u093e\u092e",mr:"\u0905\u0930\u094d\u091c\u0926\u093e\u0930\u093e\u091a\u0947 \u092a\u0942\u0930\u094d\u0923 \u0928\u093e\u0935"},placeholder:{en:"e.g. Anand Deshmukh",hi:"\u0909\u0926\u093e. \u0906\u0928\u0902\u0926 \u0926\u0947\u0936\u092e\u0941\u0916",mr:"\u0909\u0926\u093e. \u0906\u0928\u0902\u0926 \u0926\u0947\u0936\u092e\u0941\u0916"},helperText:{en:"Must be an Indian Citizen.",hi:"\u092d\u093e\u0930\u0924\u0940\u092f \u0928\u093e\u0917\u0930\u093f\u0915 \u0939\u094b\u0928\u093e \u0905\u0928\u093f\u0935\u093e\u0930\u094d\u092f \u0939\u0948\u0964",mr:"\u092d\u093e\u0930\u0924\u0940\u092f \u0928\u093e\u0917\u0930\u093f\u0915 \u0905\u0938\u0923\u0947 \u0906\u0935\u0936\u094d\u092f\u0915."},type:"text",required:!0,validation:{minLength:3,maxLength:100}},{id:"applicantAddress",label:{en:"Postal Address for Response",hi:"\u0909\u0924\u094d\u0924\u0930 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0939\u0947\u0924\u0941 \u0921\u093e\u0915 \u092a\u0924\u093e",mr:"\u0909\u0924\u094d\u0924\u0930 \u092e\u093f\u0933\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u091f\u092a\u093e\u0932 \u092a\u0924\u094d\u0924\u093e"},placeholder:{en:"e.g. 104, Green Park, Shivajinagar, Pune - 411005",hi:"\u0909\u0926\u093e. 104, \u0917\u094d\u0930\u0940\u0928 \u092a\u093e\u0930\u094d\u0915, \u0936\u093f\u0935\u093e\u091c\u0940\u0928\u0917\u0930, \u092a\u0941\u0923\u0947",mr:"\u0909\u0926\u093e. \u0967\u0966\u096a, \u0917\u094d\u0930\u0940\u0928 \u092a\u093e\u0930\u094d\u0915, \u0936\u093f\u0935\u093e\u091c\u0940\u0928\u0917\u0930, \u092a\u0941\u0923\u0947 - \u096a\u0967\u0967\u0966\u0966\u096b"},helperText:{en:"PIO will send certified reply to this address.",hi:"\u092a\u0940\u0906\u0908\u0913 \u0907\u0938 \u092a\u0924\u0947 \u092a\u0930 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0921\u093e\u0915 \u0938\u0947 \u091c\u0935\u093e\u092c \u092d\u0947\u091c\u0947\u0902\u0917\u0947\u0964",mr:"\u092f\u093e \u092a\u0924\u094d\u0924\u094d\u092f\u093e\u0935\u0930 \u0905\u0927\u093f\u0915\u0943\u0924 \u092e\u093e\u0939\u093f\u0924\u0940 \u092a\u093e\u0920\u0935\u0932\u0940 \u091c\u093e\u0908\u0932."},type:"textarea",required:!0,validation:{minLength:10,maxLength:200}},{id:"applicantContact",label:{en:"Mobile / Email Address",hi:"\u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 / \u0908\u092e\u0947\u0932 \u092a\u0924\u093e",mr:"\u092d\u094d\u0930\u092e\u0923\u0927\u094d\u0935\u0928\u0940 / \u0908\u092e\u0947\u0932"},placeholder:{en:"9876543210 / applicant@gmail.com",hi:"9876543210",mr:"\u096f\u096e\u096d\u096c\u096b\u096a\u0969\u0968\u0967\u0966"},helperText:{en:"For telephonic clarification if needed.",hi:"\u0926\u0942\u0930\u092d\u093e\u0937 \u0938\u0902\u092a\u0930\u094d\u0915 \u0939\u0947\u0924\u0941\u0964",mr:"\u0938\u0902\u092a\u0930\u094d\u0915\u093e\u0938\u093e\u0920\u0940."},type:"text",required:!0,validation:{minLength:10,maxLength:80}},{id:"particularsOfInfo",label:{en:"Particulars of Information Sought (Specific Questions)",hi:"\u0935\u093e\u0902\u091b\u093f\u0924 \u0938\u0942\u091a\u0928\u093e \u0915\u093e \u0935\u093f\u0935\u0930\u0923 (\u0935\u093f\u0936\u093f\u0937\u094d\u091f \u092a\u094d\u0930\u0936\u094d\u0928)",mr:"\u092e\u093e\u0917\u093f\u0924\u0932\u0947\u0932\u094d\u092f\u093e \u092e\u093e\u0939\u093f\u0924\u0940\u091a\u093e \u0924\u092a\u0936\u0940\u0932 (\u0935\u093f\u0936\u093f\u0937\u094d\u091f \u092a\u094d\u0930\u0936\u094d\u0928)"},placeholder:{en:"1. Certified copy of tender sanction order for road repairs on MG Road.\n2. Total funds allocated and disbursed till date.\n3. Inspection of measurement books for the project.",hi:"1. \u0938\u0921\u093c\u0915 \u092e\u0930\u092e\u094d\u092e\u0924 \u0939\u0947\u0924\u0941 \u0938\u094d\u0935\u0940\u0915\u0943\u0924 \u0928\u093f\u0935\u093f\u0926\u093e \u0915\u0940 \u092a\u094d\u0930\u092e\u093e\u0923\u093f\u0924 \u092a\u094d\u0930\u0924\u093f\u0932\u093f\u092a\u093f\u0964\n2. \u0905\u092c \u0924\u0915 \u0906\u0935\u0902\u091f\u093f\u0924 \u090f\u0935\u0902 \u0935\u094d\u092f\u092f \u0915\u0940 \u0917\u0908 \u0915\u0941\u0932 \u0927\u0928\u0930\u093e\u0936\u093f \u0915\u093e \u0935\u093f\u0935\u0930\u0923\u0964",mr:"\u0967. \u0930\u0938\u094d\u0924\u093e \u0926\u0941\u0930\u0941\u0938\u094d\u0924\u0940\u091a\u094d\u092f\u093e \u0915\u093e\u092e\u093e\u091a\u094d\u092f\u093e \u091f\u0947\u0902\u0921\u0930\u091a\u0940 \u092a\u094d\u0930\u092e\u093e\u0923\u093f\u0924 \u092a\u094d\u0930\u0924.\n\u0968. \u092e\u0902\u091c\u0942\u0930 \u0935 \u0916\u0930\u094d\u091a \u091d\u093e\u0932\u0947\u0932\u093e \u090f\u0915\u0942\u0923 \u0928\u093f\u0927\u0940\u091a\u093e \u0924\u092a\u0936\u0940\u0932."},helperText:{en:"Keep questions specific, precise, and numbered. Do not ask for opinions or 'why'.",hi:"\u092a\u094d\u0930\u0936\u094d\u0928 \u0938\u094d\u092a\u0937\u094d\u091f, \u0938\u0902\u0916\u094d\u092f\u093e\u092c\u0926\u094d\u0927 \u090f\u0935\u0902 \u0935\u0938\u094d\u0924\u0941\u092a\u0930\u0915 \u0930\u0916\u0947\u0902\u0964 \u0930\u093e\u092f \u092f\u093e '\u0915\u094d\u092f\u094b\u0902' \u0928 \u092a\u0942\u091b\u0947\u0902\u0964",mr:"\u092a\u094d\u0930\u0936\u094d\u0928 \u0928\u0947\u092e\u0915\u0947 \u0906\u0923\u093f \u092e\u0941\u0926\u094d\u092f\u093e\u0902\u0928\u0941\u0938\u093e\u0930 \u0905\u0938\u093e\u0935\u0947\u0924. '\u0915\u093e' \u0905\u0938\u0947 \u0935\u093f\u091a\u093e\u0930\u0942 \u0928\u092f\u0947."},type:"textarea",required:!0,validation:{minLength:20,maxLength:1500}},{id:"bplStatus",label:{en:"Is Applicant Below Poverty Line (BPL)?",hi:"\u0915\u094d\u092f\u093e \u0906\u0935\u0947\u0926\u0915 \u0917\u0930\u0940\u092c\u0940 \u0930\u0947\u0916\u093e \u0938\u0947 \u0928\u0940\u091a\u0947 (BPL) \u0939\u0948?",mr:"\u0905\u0930\u094d\u091c\u0926\u093e\u0930 \u0926\u093e\u0930\u093f\u0926\u094d\u0930\u094d\u092f\u0930\u0947\u0937\u0947\u0916\u093e\u0932\u0940\u0932 (BPL) \u0906\u0939\u0947 \u0915\u093e?"},placeholder:{en:"No",hi:"\u0928\u0939\u0940\u0902",mr:"\u0928\u093e\u0939\u0940"},helperText:{en:"BPL applicants are exempt from application and copying fees.",hi:"\u092c\u0940\u092a\u0940\u090f\u0932 \u0906\u0935\u0947\u0926\u0915\u094b\u0902 \u0915\u094b \u0906\u0935\u0947\u0926\u0928 \u0936\u0941\u0932\u094d\u0915 \u0938\u0947 \u091b\u0942\u091f \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u0948\u0964",mr:"\u092c\u0940\u092a\u0940\u090f\u0932 \u0905\u0930\u094d\u091c\u0926\u093e\u0930\u093e\u0902\u0928\u093e \u0936\u0941\u0932\u094d\u0915 \u092e\u093e\u092b\u0940 \u0905\u0938\u0924\u0947."},type:"select",required:!0,options:[{value:"no",label:{en:"No (Enclosing \u20b910 Fee via IPO / Stamp)",hi:"\u0928\u0939\u0940\u0902 (\u20b910 \u0936\u0941\u0932\u094d\u0915 \u0938\u0902\u0932\u0917\u094d\u0928)",mr:"\u0928\u093e\u0939\u0940 (\u20b9\u0967\u0966 \u0936\u0941\u0932\u094d\u0915 \u0938\u092e\u093e\u0935\u093f\u0937\u094d\u091f)"}},{value:"yes",label:{en:"Yes (BPL Card Attached - Fee Exempt)",hi:"\u0939\u093e\u0901 (\u092c\u0940\u092a\u0940\u090f\u0932 \u0915\u093e\u0930\u094d\u0921 \u0938\u0902\u0932\u0917\u094d\u0928 - \u0936\u0941\u0932\u094d\u0915 \u092e\u0941\u0915\u094d\u0924)",mr:"\u0939\u094b\u092f (\u092c\u0940\u092a\u0940\u090f\u0932 \u0915\u093e\u0930\u094d\u0921 \u091c\u094b\u0921\u0932\u0947 \u0906\u0939\u0947)"}}]}]}},2552,[]);
__d(function(e,t,n,a,r,i,l){r.exports={id:"rental-agreement",title:{en:"Residential Rental / Lease Agreement",hi:"\u0906\u0935\u093e\u0938\u0940\u092f \u0915\u093f\u0930\u093e\u092f\u093e / \u092a\u091f\u094d\u091f\u093e \u0905\u0928\u0941\u092c\u0902\u0927",mr:"\u0918\u0930 \u092d\u093e\u0921\u0947 / \u0932\u093f\u0935\u094d\u0939 \u0905\u0901\u0921 \u0932\u093e\u092f\u0938\u0928\u094d\u0938 \u0915\u0930\u093e\u0930\u0928\u093e\u092e\u093e"},description:{en:"11-month standard residential tenancy agreement between Landlord (Licensor) and Tenant (Licensee).",hi:"\u092e\u0915\u093e\u0928 \u092e\u093e\u0932\u093f\u0915 \u0914\u0930 \u0915\u093f\u0930\u093e\u090f\u0926\u093e\u0930 \u0915\u0947 \u092c\u0940\u091a 11 \u092e\u0939\u0940\u0928\u0947 \u0915\u093e \u092e\u093e\u0928\u0915 \u0906\u0935\u093e\u0938\u0940\u092f \u0915\u093f\u0930\u093e\u092f\u093e \u0905\u0928\u0941\u092c\u0902\u0927\u0964",mr:"\u0918\u0930\u092e\u093e\u0932\u0915 \u0906\u0923\u093f \u092d\u093e\u0921\u0947\u0915\u0930\u0942 \u092f\u093e\u0902\u091a\u094d\u092f\u093e\u0924\u0940\u0932 \u0967\u0967 \u092e\u0939\u093f\u0928\u094d\u092f\u093e\u0902\u091a\u093e \u0915\u093e\u092f\u0926\u0947\u0936\u0940\u0930 \u092d\u093e\u0921\u0947\u0915\u0930\u093e\u0930."},category:"Property & Tenancy",source:"Transfer of Property Act, 1882 & State Rent Control Acts / Model Tenancy Act 2021",lastUpdated:"2024-07-01",reviewStatus:"UNREVIEWED",stateStampDutyNote:"Stamp duty rates and mandatory registration vary by State (e.g. in Maharashtra, registration of Leave and License is mandatory under Section 55 of Maharashtra Rent Control Act; in Karnataka/Delhi, 11-month agreements are typically executed on \u20b9100 or \u20b9500 e-stamp).",todo:"TODO: Requires advocate review, e-stamp paper purchase in accordance with state laws, and execution before two witnesses.",fields:[{id:"landlordName",label:{en:"Landlord (Owner) Full Name",hi:"\u092e\u0915\u093e\u0928 \u092e\u093e\u0932\u093f\u0915 (\u0938\u094d\u0935\u093e\u092e\u0940) \u0915\u093e \u092a\u0942\u0930\u093e \u0928\u093e\u092e",mr:"\u0918\u0930\u092e\u093e\u0932\u0915\u093e\u091a\u0947 \u092a\u0942\u0930\u094d\u0923 \u0928\u093e\u0935"},placeholder:{en:"e.g. Satish Narang",hi:"\u0909\u0926\u093e. \u0938\u0924\u0940\u0936 \u0928\u093e\u0930\u0902\u0917",mr:"\u0909\u0926\u093e. \u0938\u0924\u0940\u0936 \u0928\u093e\u0930\u0902\u0917"},helperText:{en:"Legal owner of the premises.",hi:"\u0938\u0902\u092a\u0924\u094d\u0924\u093f \u0915\u093e \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u0938\u094d\u0935\u093e\u092e\u0940\u0964",mr:"\u091c\u093e\u0917\u0947\u091a\u093e \u0915\u093e\u092f\u0926\u0947\u0936\u0940\u0930 \u092e\u093e\u0932\u0915."},type:"text",required:!0,validation:{minLength:3,maxLength:100}},{id:"tenantName",label:{en:"Tenant Full Name",hi:"\u0915\u093f\u0930\u093e\u090f\u0926\u093e\u0930 \u0915\u093e \u092a\u0942\u0930\u093e \u0928\u093e\u092e",mr:"\u092d\u093e\u0921\u0947\u0915\u0930\u0942\u091a\u0947 \u092a\u0942\u0930\u094d\u0923 \u0928\u093e\u0935"},placeholder:{en:"e.g. Rohit Verma",hi:"\u0909\u0926\u093e. \u0930\u094b\u0939\u093f\u0924 \u0935\u0930\u094d\u092e\u093e",mr:"\u0909\u0926\u093e. \u0930\u094b\u0939\u093f\u0924 \u0935\u0930\u094d\u092e\u093e"},helperText:{en:"Person taking the property on rent.",hi:"\u0915\u093f\u0930\u093e\u090f \u092a\u0930 \u0930\u0939\u0928\u0947 \u0935\u093e\u0932\u093e \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0964",mr:"\u091c\u093e\u0917\u093e \u092d\u093e\u0921\u094d\u092f\u093e\u0928\u0947 \u0918\u0947\u0923\u093e\u0930\u0940 \u0935\u094d\u092f\u0915\u094d\u0924\u0940."},type:"text",required:!0,validation:{minLength:3,maxLength:100}},{id:"premisesAddress",label:{en:"Rental Premises Complete Address",hi:"\u0915\u093f\u0930\u093e\u090f \u0915\u0947 \u092e\u0915\u093e\u0928 \u0915\u093e \u092a\u0942\u0930\u093e \u092a\u0924\u093e",mr:"\u092d\u093e\u0921\u094d\u092f\u093e\u0928\u0947 \u0926\u093f\u0932\u0947\u0932\u094d\u092f\u093e \u0918\u0930\u093e\u091a\u093e \u093