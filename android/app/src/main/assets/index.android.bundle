0932 \u0924\u094d\u0930\u0941\u091f\u0940 \u0915\u093f\u0902\u0935\u093e \u0935\u0938\u094d\u0924\u0942\u0924\u0940\u0932 \u0926\u094b\u0937"},placeholder:{en:"Gas leakage within 5 days of purchase. Service engineer failed to repair after 4 visits, refused refund or replacement.",hi:"\u0935\u093e\u0930\u0902\u0935\u093e\u0930 \u0936\u093f\u0915\u093e\u092f\u0924 \u0915\u0947 \u092c\u093e\u0926 \u092d\u0940 \u0938\u0941\u0927\u093e\u0930 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0914\u0930 \u0930\u093f\u092b\u0902\u0921 \u0926\u0947\u0928\u0947 \u0938\u0947 \u092e\u0928\u093e \u0915\u0930 \u0926\u093f\u092f\u093e\u0964",mr:"\u0935\u0938\u094d\u0924\u0942\u0924 \u092c\u093f\u0918\u093e\u0921 \u091d\u093e\u0932\u093e \u0905\u0938\u0942\u0928 \u0926\u0941\u0930\u0941\u0938\u094d\u0924 \u0915\u0930\u0942\u0928 \u0926\u093f\u0932\u0940 \u0928\u093e\u0939\u0940 \u0915\u093f\u0902\u0935\u093e \u092a\u0948\u0938\u0947 \u092a\u0930\u0924 \u0915\u0947\u0932\u0947 \u0928\u093e\u0939\u0940\u0924."},helperText:{en:"Explain defects and how seller failed to fulfill warranty/service.",hi:"\u0938\u092e\u0938\u094d\u092f\u093e \u0914\u0930 \u0915\u0902\u092a\u0928\u0940 \u0915\u0940 \u0932\u093e\u092a\u0930\u0935\u093e\u0939\u0940 \u0938\u094d\u092a\u0937\u094d\u091f \u092c\u0924\u093e\u090f\u0902\u0964",mr:"\u0924\u094d\u0930\u093e\u0938 \u0906\u0923\u093f \u0915\u0902\u092a\u0928\u0940\u091a\u0940 \u0928\u093f\u0937\u094d\u0915\u093e\u0933\u091c\u0940\u092a\u0923\u093e \u0938\u094d\u092a\u0937\u094d\u091f \u0932\u093f\u0939\u093e."},type:"textarea",required:!0,validation:{minLength:20,maxLength:1e3}},{id:"reliefClaimed",label:{en:"Relief / Compensation Claimed (INR \u20b9)",hi:"\u092e\u093e\u0902\u0917\u0940 \u0917\u0908 \u0930\u093e\u0939\u0924 \u090f\u0935\u0902 \u0939\u0930\u094d\u091c\u093e\u0928\u093e (\u0930\u0941\u092a\u092f\u0947 \u20b9 \u092e\u0947\u0902)",mr:"\u092e\u093e\u0917\u093f\u0924\u0932\u0947\u0932\u0940 \u0928\u0941\u0915\u0938\u093e\