__d(function(e,t,a,r,o,n,i){o.exports={title:"LawGPT Privacy Policy",statutoryFramework:"Digital Personal Data Protection Act, 2023 (DPDP Act 2023) & IT Act 2000",lastUpdated:"2024-07-01",sections:[{heading:"1. Zero Third-Party Monetization",body:"LawGPT processes user questions solely to deliver legal information, citations, and procedural assistance. We never sell, rent, or lease your personal data or query logs to marketing networks or third parties."},{heading:"2. Client-Side Encryption & Secure Token Storage",body:"Authentication tokens are retained solely within your device's hardware-backed encrypted storage (expo-secure-store). Saved items, case diary entries, and consultation history reside on your local device."},{heading:"3. DPDP Act 2023 Data Portability & Complete Erasure",body:"In full compliance with Section 6 and Section 12 of the DPDP Act 2023, you have the absolute right to export your entire dataset in machine-readable JSON format at any time, or execute a hard purge ('Delete All My Data') that permanently destroys all cached records on this device."},{heading:"4. Sovereign Processing",body:"All backend AI inference requests are transmitted over encrypted TLS 1.3 tunnels and processed in accordance with Indian sovereign data security protocols."}]}},2528,[]);
__d(function(e,t,a,i,o,r,s){o.exports={title:"LawGPT Terms of Service & Statutory Disclaimer",statutoryFramework:"Advocates Act, 1961 & Bar Council of India Rules",lastUpdated:"2024-07-01",sections:[{heading:"1. Nature of Advisory Service",body:"LawGPT is an AI-powered legal information assistant designed to demystify Indian statutory provisions, including the Bharatiya Nyaya Sanhita (BNS 2023), Bharatiya Nagarik Suraksha Sanhita (BNSS 2023), and Bharatiya Sakshya Adhiniyam (BSA 2023). LawGPT does NOT constitute court attorney representation, formal legal advice, or a substitute for counsel enrolled under the Advocates Act, 1961."},{heading:"2. No Attorney-Client Privilege",body:"Use of LawGPT does not create an attorney-client relationship. Litigants facing criminal prosecution, arrest, civil forfeiture, or complex disputes should engage an enrolled advocate or seek assistance through the Legal Services Authorities (NALSA/DLSA)."},{heading:"3. Accuracy & Verification",body:"While LawGPT references verified gazette texts and Supreme Court precedents, legislative amendments and state-specific variations occur continuously. Users must verify all statutory sections, drafts, and court procedures before submitting documents to any court or authority."},{heading:"4. Emergency Situations",body:"In cases of immediate physical danger, cyber financial distress, domestic violence, or illegal detention, users must immediately contact official emergency services (112, 1930, 1091) or visit the nearest police station."}]}},2529,[]);
