__d(function(e,i,a,r,t,n,l){t.exports={id:"bail-draft",title:{en:"Bail Application Draft (BNSS)",hi:"\u091c\u092e\u093e\u0928\u0924 \u0906\u0935\u0947\u0926\u0928 \u092a\u094d\u0930\u093e\u0930\u0942\u092a (\u0928\u093e\u0917\u0930\u093f\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0902\u0939\u093f\u0924\u093e)",mr:"\u091c\u093e\u092e\u0940\u0928 \u0905\u0930\u094d\u091c \u092a\u094d\u0930\u093e\u0930\u0942\u092a (\u0928\u093e\u0917\u0930\u093f\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0902\u0939\u093f\u0924\u093e)"},description:{en:"Pro-forma regular or pre-arrest bail petition under Section 480 / 482 of Bharatiya Nagarik Suraksha Sanhita, 2023.",hi:"\u092d\u093e\u0930\u0924\u0940\u092f \u0928\u093e\u0917\u0930\u093f\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0902\u0939\u093f\u0924\u093e, 2023 \u0915\u0940 \u0927\u093e\u0930\u093e 480 / 482 \u0915\u0947 \u0924\u0939\u0924 \u091c\u092e\u093e\u0928\u0924 \u0905\u0930\u094d\u091c\u0940 \u0915\u093e \u092a\u094d\u0930\u093e\u0930\u0942\u092a\u0964",mr:"\u092d\u093e\u0930\u0924\u0940\u092f \u0928\u093e\u0917\u0930\u093f\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0902\u0939\u093f\u0924\u093e, \u0968\u0966\u0968\u0969 \u091a\u094d\u092f\u093e \u0915\u0932\u092e \u096a\u096e\u0966 / \u096a\u096e\u0968 \u0905\u0902\u0924\u0930\u094d\u0917\u0924 \u091c\u093e\u092e\u0940\u0928 \u0905\u0930\u094d\u091c\u093e\u091a\u093e \u0928\u092e\u0941\u0928\u093e."},category:"Criminal Law & Liberty",source:"Bharatiya Nagarik Suraksha Sanhita, 2023 (BNSS) & High Court Criminal Rules of Practice",lastUpdated:"2024-07-01",reviewStatus:"UNREVIEWED",todo:"TODO: CRITICAL: Requires formal representation and signing by an enrolled Advocate before the Sessions Court or High Court.",fields:[{id:"courtName",label:{en:"Court of Presentation",hi:"\u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u093e \u0928\u093e\u092e",mr:"\u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f\u093e\u091a\u0947 \u0928\u093e\u0935"},placeholder:{en:"In the Court of Ld. Sessions Judge, Tis Hazari Courts, Delhi",hi:"\u0935\u093f\u0926\u094d\u0935\u093e\u0928 \u0938\u0924\u094d\u0930 \u0928\u094d\u092f\u093e\u092f\u093e\u0927\u0940\u0936, \u0915\u0921\u093c\u0915\u0921\u093c\u0921\u0942\u092e\u093e \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f, \u0926\u093f\u0932\u094d\u0932\u0940",mr:"\u092e\u093e. \u0938\u0924\u094d\u0930 \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f, \u092a\u0941\u0923\u0947"},helperText:{en:"Competent jurisdictional court where application is filed.",hi:"\u0915\u094d\u0937\u0947\u0924\u094d\u0930\u093e\u0927\u093f\u0915\u093e\u0930 \u0935\u093e\u0932\u093e \u0938\u0915\u094d\u0937\u092e \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f\u0964",mr:"\u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0905\u0927\u093f\u0915\u093e\u0930\u0915\u094d\u0937\u0947\u0924\u094d\u0930\u093e\u0924\u0940\u0932 \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f."},type:"text",required:!0,validation:{minLength:5,maxLength:150}},{id:"applicantName",label:{en:"Applicant / Accused Full Name",hi:"\u0906\u0935\u0947\u0926\u0915 / \u0905\u092d\u093f\u092f\u0941\u0915\u094d\u0924 \u0915\u093e \u092a\u0942\u0930\u093e \u0928\u093e\u092e",mr:"\u0905\u0930\u094d\u091c\u0926\u093e\u0930 / \u0906\u0930\u094b\u092a\u0940\u091a\u0947 \u092a\u0942\u0930\u094d\u0923 \u0928\u093e\u0935"},placeholder:{en:"e.g. Vikas Yadav S/o Late Sh. Om Prakash",hi:"\u0909\u0926\u093e. \u0935\u093f\u0915\u093e\u0938 \u092f\u093e\u0926\u0935",mr:"\u0909\u0926\u093e. \u0935\u093f\u0915\u093e\u0938 \u092f\u093e\u0926\u0935"},helperText:{en:"Name and parentage of the applicant seeking bail.",hi:"\u091c\u092e\u093e\u0928\u0924 \u091a\u093e\u0939\u0928\u0947 \u0935\u093e\u0932\u0947 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0915\u093e \u0928\u093e\u092e \u0935 \u092a\u093f\u0924\u093e \u0915\u093e \u0928\u093e\u092e\u0964",mr:"\u091c\u093e\u092e\u093f\u0928\u093e\u0938\u093e\u0920\u0940 \u0905\u0930\u094d\u091c \u0915\u0930\u0923\u093e\u0931\u094d\u092f\u093e \u0935\u094d\u092f\u0915\u094d\u0924\u0940\u091a\u0947 \u0928\u093e\u0935."},type:"text",required:!0,validation:{minLength:3,maxLength:100}},{id:"firNumber",label:{en:"FIR Number & Year",hi:"\u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915\u0940 (FIR) \u0938\u0902\u0916\u094d\u092f\u093e \u090f\u0935\u0902 \u0935\u0930\u094d\u0937",mr:"\u090f\u092b\u0906\u092f\u0906\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0906\u0923\u093f \u0935\u0930\u094d\u0937"},placeholder:{en:"FIR No. 142/2024",hi:"\u090f\u092b\u0906\u0908\u0906\u0930 \u0928\u0902. 142/2024",mr:"\u0917\u0941\u0928\u094d\u0939\u093e \u0915\u094d\u0930. \u0967\u096a\u0968/\u0968\u0966\u0968\u096a"},helperText:{en:"Police case register number.",hi:"\u0925\u093e\u0928\u093e \u0905\u092a\u0930\u093e\u0927 \u0915\u094d\u0930\u092e\u093e\u0902\u0915\u0964",mr:"\u092a\u094b\u0932\u0940\u0938 \u0920\u093e\u0923\u094d\u092f\u093e\u0924\u0940\u0932 \u0917\u0941\u0928\u094d\u0939\u093e \u0928\u094b\u0902\u0926 \u0915\u094d\u0930\u092e\u093e\u0902\u0915."},type:"text",required:!0,validation:{minLength:3,maxLength:50}},{id:"policeStation",label:{en:"Police Station (Thana)",hi:"\u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0925\u093e\u0928\u093e / \u092a\u0941\u0932\u093f\u0938 \u0938\u094d\u091f\u0947\u0936\u0928",mr:"\u092a\u094b\u0932\u0940\u0938 \u0920\u093e\u0923\u0947"},placeholder:{en:"P.S. Hauz Khas, South Delhi",hi:"\u0925\u093e\u0928\u093e \u0939\u094c\u091c \u0916\u093e\u0938",mr:"\u092a\u094b\u0932\u0940\u0938 \u0920\u093e\u0923\u0947, \u0939\u094c\u091c \u0916\u093e\u0938"},helperText:{en:"Jurisdictional police station where FIR is registered.",hi:"\u0935\u0939 \u092a\u0941\u0932\u093f\u0938 \u0925\u093e\u0928\u093e \u091c\u0939\u093e\u0902 \u092e\u093e\u092e\u0932\u093e \u0926\u0930\u094d\u091c \u0939\u0948\u0964",mr:"\u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092a\u094b\u0932\u0940\u0938 \u0920\u093e\u0923\u0947."},type:"text",required:!0,validation:{minLength:3,maxLength:80}},{id:"sectionsInvoked",label:{en:"Sections Invoked (BNS / IPC)",hi:"\u0932\u0917\u093e\u0908 \u0917\u0908 \u0927\u093e\u0930\u093e\u090f\u0902 (BNS / IPC)",mr:"\u0926\u093e\u0916\u0932 \u0915\u0947\u0932\u0947\u0932\u0940 \u0915\u0932\u092e\u0947"},placeholder:{en:"Under Sections 115(2), 351(2), 352 BNS (formerly 323, 504, 506 IPC)",hi:"\u0927\u093e\u0930\u093e 115(2), 351(2) \u092c\u0940\u090f\u0928\u090f\u0938",mr:"\u0915\u0932\u092e \u0967\u0967\u096b(\u0968), \u0969\u096b\u0967(\u0968) \u092c\u0940\u090f\u0928\u090f\u0938"},helperText:{en:"Offences alleged in the FIR.",hi:"\u090f\u092b\u0906\u0908\u0906\u0930 \u092e\u0947\u0902 \u0926\u0930\u094d\u091c \u0915\u0925\u093f\u0924 \u0905\u092a\u0930\u093e\u0927 \u0927\u093e\u0930\u093e\u090f\u0902\u0964",mr:"\u0917\u0941\u0928\u094d\u0939\u094d\u092f\u093e\u092e\u0927\u094d\u092f\u0947 \u0932\u093e\u0935\u0932\u0947\u0932\u0940 \u0915\u0932\u092e\u0947."},type:"text",required:!0,validation:{minLength:3,maxLength:150}},{id:"bailType",label:{en:"Type of Bail Sought",hi:"\u091c\u092e\u093e\u0928\u0924 \u0915\u093e \u092a\u094d\u0930\u0915\u093e\u0930",mr:"\u091c\u093e\u092e\u093f\u0928\u093e\u091a\u093e \u092a\u094d\u0930\u0915\u093e\u0930"},placeholder:{en:"Regular Bail",hi:"\u0928\u093f\u092f\u092e\u093f\u0924 \u091c\u092e\u093e\u0928\u0924",mr:"\u0928\u093f\u092f\u092e\u093f\u0924 \u091c\u093e\u092e\u0940\u0928"},helperText:{en:"Regular Bail (in custody) or Anticipatory Bail (apprehension of arrest).",hi:"\u0928\u093f\u092f\u092e\u093f\u0924 \u091c\u092e\u093e\u0928\u0924 (\u0939\u093f\u0930\u093e\u0938\u0924 \u092e\u0947\u0902) \u092f\u093e \u0905\u0917\u094d\u0930\u093f\u092e \u091c\u092e\u093e\u0928\u0924 (\u0917\u093f\u0930\u092b\u094d\u0924\u093e\u0930\u0940 \u0915\u0940 \u0906\u0936\u0902\u0915\u093e)\u0964",mr:"\u0928\u093f\u092f\u092e\u093f\u0924 \u091c\u093e\u092e\u0940\u0928 \u0915\u093f\u0902\u0935\u093e \u0905\u091f\u0915\u092a\u0942\u0930\u094d\u0935 \u091c\u093e\u092e\u0940\u0928."},type:"select",required:!0,options:[{value:"regular",label:{en:"Regular Bail (Sec 480 BNSS / 439 CrPC)",hi:"\u0928\u093f\u092f\u092e\u093f\u0924 \u091c\u092e\u093e\u0928\u0924 (\u0927\u093e\u0930\u093e 480 \u092c\u0940\u090f\u0928\u090f\u0938\u090f\u0938)",mr:"\u0928\u093f\u092f\u092e\u093f\u0924 \u091c\u093e\u092e\u0940\u0928 (\u0915\u0932\u092e \u096a\u096e\u0966 \u092c\u0940\u090f\u0928\u090f\u0938\u090f\u0938)"}},{value:"anticipatory",label:{en:"Anticipatory Bail (Sec 482 BNSS / 438 CrPC)",hi:"\u0905\u0917\u094d\u0930\u093f\u092e \u091c\u092e\u093e\u0928\u0924 (\u0927\u093e\u0930\u093e 482 \u092c\u0940\u090f\u0928\u090f\u0938\u090f\u0938)",mr:"\u0905\u091f\u0915\u092a\u0942\u0930\u094d\u0935 \u091c\u093e\u092e\u0940\u0928 (\u0915\u0932\u092e \u096a\u096e\u0968 \u092c\u0940\u090f\u0928\u090f\u0938\u090f\u0938)"}},{value:"interim",label:{en:"Interim Bail",hi:"\u0905\u0902\u0924\u0930\u093f\u092e \u091c\u092e\u093e\u0928\u0924",mr:"\u0924\u093e\u0924\u094d\u092a\u0941\u0930\u0924\u093e \u091c\u093e\u092e\u0940\u0928"}}]},{id:"groundsForBail",label:{en:"Grounds for Bail (Key Legal Reasons)",hi:"\u091c\u092e\u093e\u0928\u0924 \u0915\u0947 \u0906\u0927\u093e\u0930 (\u0935\u093f\u0927\u093f\u0915 \u0915\u093e\u0930\u0923)",mr:"\u091c\u093e\u092e\u093f\u0928\u093e\u091a\u0940 \u0915\u093e\u092f\u0926\u0947\u0936\u0940\u0930 \u0915\u093e\u0930\u0923\u0947"},placeholder:{en:"1. False implication due to civil animosity.\n2. Applicant has deep roots in society and is not a flight risk.\n3. Investigation complete, recovery effected, custodial interrogation no longer required.\n4. Undertakes to cooperate with police and abide by all conditions.",hi:"1. \u0906\u0935\u0947\u0926\u0915 \u0928\u093f\u0930\u094d\u0926\u094b\u0937 \u0939\u0948 \u0924\u0925\u093e \u0909\u0938\u0947 \u0930\u0902\u091c\u093f\u0936\u0935\u0936 \u092b\u0902\u0938\u093e\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964\n2. \u0906\u0935\u0947\u0926\u0915 \u0938\u092e\u093e\u091c \u092e\u0947\u0902 \u092a\u094d\u0930\u0924\u093f\u0937\u094d\u0920\u093f\u0924 \u0939\u0948 \u0914\u0930 \u092d\u093e\u0917\u0928\u0947 \u0915\u093e \u0915\u094b\u0908 \u0916\u0924\u0930\u093e \u0928\u0939\u0940\u0902 \u0939\u0948\u0964\n3. \u0915\u094b\u0908 \u0906\u092a\u0930\u093e\u0927\u093f\u0915 \u092a\u0942\u0930\u094d\u0935\u0935\u0943\u0924\u094d\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964",mr:"\u0967. \u0905\u0930\u094d\u091c\u0926\u093e\u0930 \u0928\u093f\u0937\u094d\u092a\u093e\u092a \u0905\u0938\u0942\u0928 \u0924\u094d\u092f\u093e\u0932\u093e \u0916\u094b\u091f\u094d\u092f\u093e \u0917\u0941\u0928\u094d\u0939\u094d\u092f\u093e\u0924 \u0905\u0921\u0915\u0935\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u0947 \u0906\u0939\u0947.\n\u0968. \u0905\u0930\u094d\u091c\u0926\u093e\u0930\u093e\u091a\u093e \u0915\u094b\u0923\u0924\u093e\u0939\u0940 \u092a\u0942\u0930\u094d\u0935\u0917\u0941\u0928\u094d\u0939\u0947\u0917\u093e\u0930\u0940 \u0907\u0924\u093f\u0939\u093e\u0938 \u0928\u093e\u0939\u0940.\n\u0969. \u0924\u092a\u093e\u0938\u093e\u0924 \u092a\u0942\u0930\u094d\u0923 \u0938\u0939\u0915\u093e\u0930\u094d\u092f \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u0947 \u0939\u092e\u0940\u092a\u0924\u094d\u0930."},helperText:{en:"Key merits: innocence, lack of criminal antecedents, cooperation, medical grounds.",hi:"\u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u092c\u093f\u0902\u0926\u0941: \u0928\u093f\u0930\u094d\u0926\u094b\u0937\u0924\u093e, \u091c\u093e\u0902\u091a \u092e\u0947\u0902 \u0938\u0939\u092f\u094b\u0917, \u0938\u092e\u093e\u091c \u092e\u0947\u0902 \u092a\u094d\u0930\u0924\u093f\u0937\u094d\u0920\u093e, \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0906\u0926\u093f\u0964",mr:"\u0924\u092a\u093e\u0938\u093e\u0938 \u0938\u0939\u0915\u093e\u0930\u094d\u092f, \u0928\u093f\u0937\u094d\u092a\u093e\u092a\u092a\u0923\u093e \u0935 \u0938\u092e\u093e\u091c\u092a\u094d\u0930\u0924\u093f\u0937\u094d\u0920\u093e."},type:"textarea",required:!0,validation