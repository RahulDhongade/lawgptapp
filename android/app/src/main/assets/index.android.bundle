__d(function(e,i,t,n,o,a,r){o.exports={source:"Official Gazette of India, Acts No. 45 & 46 of 2023 (BNS 2023 & BNSS 2023)",lastUpdated:"2024-07-01",reviewStatus:"UNREVIEWED",notes:"TODO: Sourced directly from parliamentary gazette text. Requires senior advocate cross-check before public deployment.",items:[{id:"conv_ipc_302",category:"IPC_TO_BNS",oldCode:{act:"Indian Penal Code, 1860 (IPC)",section:"Section 302",title:"Punishment for Murder",description:"Whoever commits murder shall be punished with death, or imprisonment for life, and shall also be liable to fine."},newCode:{act:"Bharatiya Nyaya Sanhita, 2023 (BNS)",section:"Section 103(1)",title:"Punishment for Murder",description:"Whoever commits murder shall be punished with death or imprisonment for life, and shall also be liable to fine. Sub-clause (2) additionally covers murder by mob lynching / group on grounds of race, caste, community.",keyChanges:"Mob lynching incorporated into Section 103(2) with minimum 7 years to death penalty."},nature:"Cognizable, Non-Bailable, Triable by Court of Session"},{id:"conv_ipc_420",category:"IPC_TO_BNS",oldCode:{act:"Indian Penal Code, 1860 (IPC)",section:"Section 420",title:"Cheating and dishonestly inducing delivery of property",description:"Whoever cheats and thereby dishonestly induces the person deceived to deliver any property..."},newCode:{act:"Bharatiya Nyaya Sanhita, 2023 (BNS)",section:"Section 318(4)",title:"Cheating and dishonestly inducing delivery of property",description:"Consolidates cheating offenses. Punishment remains imprisonment of either description for a term up to seven years and fine.",keyChanges:"Section numbering consolidated under Chapter XVII (Offences Against Property)."},nature:"Cognizable, Non-Bailable, Triable by Magistrate First Class"},{id:"conv_ipc_376",category:"IPC_TO_BNS",oldCode:{act:"Indian Penal Code, 1860 (IPC)",section:"Section 376",title:"Punishment for Rape",description:"Punishment for sexual assault not less than ten years, but which may extend to life imprisonment."},newCode:{act:"Bharatiya Nyaya Sanhita, 2023 (BNS)",section:"Section 64",title:"Punishment for Rape",description:"Punishment not less than ten years, extendable to life imprisonment and fine. Section 69 additionally criminalizes sexual intercourse by deceitful means/false promise to marry.",keyChanges:"Deceitful promise of marriage explicitly criminalized under Section 69."},nature:"Cognizable, Non-Bailable, Triable by Court of Session"},{id:"conv_ipc_304a",category:"IPC_TO_BNS",oldCode:{act:"Indian Penal Code, 1860 (IPC)",section:"Section 304A",title:"Causing death by negligence",description:"Whoever causes the death of any person by doing any rash or negligent act not amounting to culpable homicide."},newCode:{act:"Bharatiya Nyaya Sanhita, 2023 (BNS)",section:"Section 106",title:"Causing death by negligence (Hit and Run)",description:"Section 106(1) provides up to 5 years for rash/negligent driving. Section 106(2) provides up to 10 years if the offender escapes without reporting to police/magistrate.",keyChanges:"Stringent provisions for hit-and-run without reporting."},nature:"Cognizable, Bailable (under 106(1)), Triable by Magistrate"},{id:"conv_ipc_379",category:"IPC_TO_BNS",oldCode:{act:"Indian Penal Code, 1860 (IPC)",section:"Section 379",title:"Punishment for Theft",description:"Imprisonment of either description for a term which may extend to three years, or with fine, or with both."},newCode:{act:"Bharatiya Nyaya Sanhita, 2023 (BNS)",section:"Section 303(2)",title:"Punishment for Theft",description:"Whoever commits theft shall be punished with imprisonment up to three years, or fine, or community service for petty first-time theft where value is under Rs. 5,000.",keyChanges:"Introduces Community Service as an alternative sanction for petty theft under Rs 5,000 on return of property."},nature:"Cognizable, Non-Bailable, Triable by any Magistrate"},{id:"conv_ipc_124a",category:"IPC_TO_BNS",oldCode:{act:"Indian Penal Code, 1860 (IPC)",section:"Section 124A",title:"Sedition (Disaffection towards Government)",description:"Punished words, signs or visible representation bringing hatred or contempt towards the Government established by law."},newCode:{act:"Bharatiya Nyaya Sanhita, 2023 (BNS)",section:"Section 152",title:"Act endangering sovereignty, unity and integrity of India",description:"Whoever intentionally incites secession, armed rebellion, subversive activities, or endangers sovereignty, unity, and integrity of India.",keyChanges:"The colonial term 'sedition' is dropped; replaced by acts endangering sovereignty, unity, and integrity with minimum 7 years to life imprisonment."},nature:"Cognizable, Non-Bailable, Triable by Court of Session"},{id:"conv_crpc_154",category:"CRPC_TO_BNSS",oldCode:{act:"Code of Criminal Procedure, 1973 (CrPC)",section:"Section 154",title:"Information in cognizable cases (FIR)",description:"Every information relating to the commission of a cognizable offence shall be reduced to writing by the officer in charge of a police station."},newCode:{act:"Bharatiya Nagarik Suraksha Sanhita, 2023 (BNSS)",section:"Section 173",title:"Information in cognizable cases (Electronic FIR & Zero FIR)",description:"Explicitly codifies electronic communication (e-FIR) to be signed within 3 days, and statutory Zero FIR irrespective of territorial jurisdiction.",keyChanges:"Zero FIR and e-FIR are now expressly codified into the statutory provision."},nature:"Mandatory Registration for Cognizable Offenses"},{id:"conv_crpc_41",category:"CRPC_TO_BNSS",oldCode:{act:"Code of Criminal Procedure, 1973 (CrPC)",section:"Section 41",title:"When police may arrest without warrant",description:"Circumstances under which a police officer may arrest an individual without a magistrate warrant."},newCode:{act:"Bharatiya Nagarik Suraksha Sanhita, 2023 (BNSS)",section:"Section 35",title:"When police may arrest without warrant",description:"Section 35(7) mandates that for offenses punishable by less than 3 years, arrest cannot be made without prior permission of an officer not below the rank of DSP if the person is infirm or elderly.",keyChanges:"Prior sanction of DSP required for certain vulnerable arrests with punishment < 3 years."},nature:"Statutory safeguards against arbitrary detention"},{id:"conv_crpc_167",category:"CRPC_TO_BNSS",oldCode:{act:"Code of Criminal Procedure, 1973 (CrPC)",section:"Section 167",title:"Procedure when investigation cannot be completed in 24 hours (Remand)",description:"Magistrate could authorize police custody only within the first 15 days of detention."},newCode:{act:"Bharatiya Nagarik Suraksha Sanhita, 2023 (BNSS)",section:"Section 187",title:"Remand procedure",description:"Police custody of up to 15 days can now be granted in whole or in parts during the entire 40 or 60 days period of the maximum detention.",keyChanges:"15-day police custody can be spread across the detention period rather than strictly limited to initial 15 days."},nature:"Magisterial Scrutiny of Police Custody"},{id:"conv_crpc_437",category:"CRPC_TO_BNSS",oldCode:{act:"Code of Criminal Procedure, 1973 (CrPC)",section:"Section 437 / 439",title:"When bail may be taken in case of non-bailable offence",description:"Special powers of High Court or Court of Session regarding bail."},newCode:{act:"Bharatiya Nagarik Suraksha Sanhita, 2023 (BNSS)",section:"Section 480 / 483",title:"Bail in non-bailable offences & Undertrial relief",description:"Section 479 of BNSS provides that first-time undertrial offenders who have spent one-third of maximum sentence shall be released on personal bond.",keyChanges:"First-time undertrial offenders eligible for bail after serving 1/3rd (instead of 1/2) of maximum sentence."},nature:"Substantive Liberty Right"}]}},2531,[]);
