__d(function(e,i,a,r,t,n,o){t.exports={id:"consumer-complaint",title:{en:"Consumer Forum Complaint",hi:"\u0909\u092a\u092d\u094b\u0915\u094d\u0924\u093e \u0906\u092f\u094b\u0917 \u0936\u093f\u0915\u093e\u092f\u0924 \u092a\u094d\u0930\u093e\u0930\u0942\u092a",mr:"\u0917\u094d\u0930\u093e\u0939\u0915 \u092e\u0902\u091a \u0924\u0915\u094d\u0930\u093e\u0930 \u0905\u0930\u094d\u091c"},description:{en:"Formal complaint format under Section 35 of the Consumer Protection Act, 2019 before District Commission.",hi:"\u0909\u092a\u092d\u094b\u0915\u094d\u0924\u093e \u0938\u0902\u0930\u0915\u094d\u0937\u0923 \u0905\u0927\u093f\u0928\u093f\u092f\u092e, 2019 \u0915\u0940 \u0927\u093e\u0930\u093e 35 \u0915\u0947 \u0924\u0939\u0924 \u091c\u093f\u0932\u093e \u0906\u092f\u094b\u0917 \u092e\u0947\u0902 \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u0930\u0928\u0947 \u0939\u0947\u0924\u0941 \u092a\u094d\u0930\u093e\u0930\u0942\u092a\u0964",mr:"\u0917\u094d\u0930\u093e\u0939\u0915 \u0938\u0902\u0930\u0915\u094d\u0937\u0923 \u0915\u093e\u092f\u0926\u093e, \u0968\u0966\u0967\u096f \u091a\u094d\u092f\u093e \u0915\u0932\u092e \u0969\u096b \u0905\u0928\u094d\u0935\u092f\u0947 \u091c\u093f\u0932\u094d\u0939\u093e \u0917\u094d\u0930\u093e\u0939\u0915 \u092e\u0902\u091a\u093e\u0915\u0921\u0947 \u0938\u093e\u0926\u0930 \u0915\u0930\u093e\u0935\u092f\u093e\u091a\u093e \u0924\u0915\u094d\u0930\u093e\u0930 \u0905\u0930\u094d\u091c."},category:"Consumer & Commercial",source:"Consumer Protection Act, 2019 (Act No. 35 of 2019)",lastUpdated:"2024-07-01",reviewStatus:"UNREVIEWED",todo:"TODO: Requires advocate review, fee payment via Bharatkosh/e-Daakhil, and verification affidavit.",fields:[{id:"complainantName",label:{en:"Complainant Name (Consumer)",hi:"\u0936\u093f\u0915\u093e\u092f\u0924\u0915\u0930\u094d\u0924\u093e \u0915\u093e \u0928\u093e\u092e",mr:"\u0924\u0915\u094d\u0930\u093e\u0930\u0926\u093e\u0930\u093e\u091a\u0947 \u0928\u093e\u0935"},placeholder:{en:"e.g. Meenakshi Sunderam",hi:"\u0909\u0926\u093e. \u092e\u0940\u0928\u093e\u0915\u094d\u0937\u0940 \u0938\u0941\u0902\u0926\u0930\u092e",mr:"\u0909\u0926\u093e. \u092e\u0940\u0928\u093e\u0915\u094d\u0937\u0940 \u0938\u0941\u0902\u0926\u0930\u092e"},helperText:{en:"Individual consumer who purchased goods or hired services.",hi:"\u0909\u092a\u092d\u094b\u0915\u094d\u0924\u093e \u091c\u093f\u0938\u0928\u0947 \u0938\u093e\u092e\u093e\u0928 \u0916\u0930\u0940\u0926\u093e \u092f\u093e \u0938\u0947\u0935\u093e \u0932\u0940\u0964",mr:"\u0935\u0938\u094d\u0924\u0942 \u0916\u0930\u0947\u0926\u0940 \u0915\u0930\u0923\u093e\u0930\u093e \u0915\u093f\u0902\u0935\u093e \u0938\u0947\u0935\u093e \u0918\u0947\u0923\u093e\u0930\u093e \u0917\u094d\u0930\u093e\u0939\u0915."},type:"text",required:!0,validation:{minLength:3,maxLength:100}},{id:"complainantAddress",label:{en:"Complainant Address & Contact",hi:"\u0936\u093f\u0915\u093e\u092f\u0924\u0915\u0930\u094d\u0924\u093e \u0915\u093e \u092a\u0924\u093e \u0935 \u0938\u0902\u092a\u0930\u094d\u0915",mr:"\u0924\u0915\u094d\u0930\u093e\u0930\u0926\u093e\u0930\u093e\u091a\u093e \u092a\u0924\u094d\u0924\u093e \u0935 \u092b\u094b\u0928"},placeholder:{en:"Flat 12B, Lakeview Apts, Chennai - 600028 | 9840123456",hi:"\u092a\u0924\u093e \u0935 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930",mr:"\u092a\u0924\u094d\u0924\u093e \u0906\u0923\u093f \u0938\u0902\u092a\u0930\u094d\u0915"},helperText:{en:"Postal communication details.",hi:"\u092a\u0924\u094d\u0930\u093e\u091a\u093e\u0930 \u0915\u093e \u092a\u0924\u093e\u0964",mr:"\u092a\u0924\u094d\u0930\u0935\u094d\u092f\u0935\u0939\u093e\u0930\u093e\u091a\u093e \u092a\u0924\u094d\u0924\u093e."},type:"textarea",required:!0,validation:{minLength:10,maxLength:200}},{id:"oppositePartyName",label:{en:"Opposite Party (Company / Seller Name)",hi:"\u0935\u093f\u092a\u0915\u094d\u0937\u0940 \u0926\u0932 (\u0915\u0902\u092a\u0928\u0940 / \u0935\u093f\u0915\u094d\u0930\u0947\u0924\u093e \u0915\u093e \u0928\u093e\u092e)",mr:"\u0