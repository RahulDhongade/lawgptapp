23\u0940 \u091a\u0947\u0915\u0932\u093f\u0938\u094d\u091f \u0906\u0923\u093f \u091d\u093f\u0930\u094b FIR \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e.",rights:"\u0906\u092a\u0932\u0947 \u0905\u0927\u093f\u0915\u093e\u0930",rightsDesc:"\u0928\u093e\u0917\u0930\u0940 \u0905\u0927\u093f\u0915\u093e\u0930: \u092a\u094b\u0932\u0940\u0938, \u092d\u093e\u0921\u0947\u0915\u0930\u0942, \u092e\u0939\u093f\u0932\u093e \u0935 \u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u093e\u092f\u0926\u093e.",legalDocuments:"\u0915\u093e\u092f\u0926\u0947\u0936\u0940\u0930 \u0926\u0938\u094d\u0924\u0910\u0935\u091c",legalDocumentsDesc:"\u0924\u092f\u093e\u0930 \u0928\u094b\u091f\u0940\u0938, \u092a\u094d\u0930\u0924\u093f\u091c\u094d\u091e\u093e\u092a\u0924\u094d\u0930\u0947 \u0906\u0923\u093f RTI \u092e\u0938\u0941\u0926\u0947.",cyber:"\u0938\u093e\u092f\u092c\u0930 \u092b\u0938\u0935\u0923\u0942\u0915 \u092e\u0926\u0924",cyberDesc:"UPI \u0906\u0923\u093f \u092c\u0901\u0915 \u092b\u0938\u0935\u0923\u0941\u0915\u0940\u0938\u093e\u0920\u0940 \u0906\u092a\u0924\u094d\u0915\u093e\u0932\u0940\u0928 \u092a\u093e\u0935\u0932\u0947.",scenario:"\u092a\u094d\u0930\u0938\u0902\u0917 \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u0915",scenarioDesc:"\u0905\u092a\u0918\u093e\u0924, \u0905\u091f\u0915 \u0915\u093f\u0902\u0935\u093e \u092a\u0917\u093e\u0930\u093e\u091a\u094d\u092f\u093e \u0935\u093e\u0926\u093e\u0938\u093e\u0920\u0940 \u0915\u0943\u0924\u0940 \u0906\u0930\u093e\u0916\u0921\u093e.",searchTool:"\u0915\u093e\u092f\u0926\u0947\u0936\u0940\u0930 \u0936\u094b\u0927",searchToolDesc:"BNS, BNSS, BSA \u0906\u0923\u093f \u0938\u0902\u0935\u093f\u0927\u093e\u0928\u093e\u0924\u0940\u0932 \u0915\u0932\u092e\u0947 \u0936\u094b\u0927\u093e.",glossary:"\u0915\u093e\u092f\u0926\u0947\u0936\u0940\u0930 \u0936\u092c\u094d\u0926\u0915\u094b\u0936",glossaryDesc:"A-Z \u092d\u093e\u0930\u0924\u0940\u092f \u0915\u093e\u092f\u0926\u0947\u0936\u0940\u0930 \u0938\u0902\u091c\u094d\u091e\u093e\u090