__d(function(e,a,i,o,s,c,l){s.exports={common:{appName:"LawGPT",appTagline:"\u092d\u093e\u0930\u0924\u093e\u091a\u093e AI \u0915\u093e\u092f\u0926\u0947\u0936\u0940\u0930 \u0938\u0939\u093e\u092f\u094d\u092f\u0915",simplifiedLaw:"\u0938\u094b\u092a\u0947 \u092d\u093e\u0930\u0924\u0940\u092f \u0915\u093e\u092f\u0926\u0947 \u2022 BNS \u2022 BNSS \u2022 \u0938\u0902\u0935\u093f\u0927\u093e\u0928",back:"\u092e\u093e\u0917\u0947",next:"\u092a\u0941\u0922\u0947",skip:"\u0935\u0917\u0933\u093e",getStarted:"\u0938\u0941\u0930\u0942 \u0915\u0930\u093e",cancel:"\u0930\u0926\u094d\u0926 \u0915\u0930\u093e",confirm:"\u092a\u0941\u0937\u094d\u091f\u0940 \u0915\u0930\u093e",save:"\u091c\u0924\u0928 \u0915\u0930\u093e",saved:"\u091c\u0924\u0928 \u0915\u0947\u0932\u0947",delete:"\u0939\u091f\u0935\u093e",search:"\u0936\u094b\u0927\u093e",loading:"\u0932\u094b\u0921 \u0939\u094b\u0924 \u0906\u0939\u0947...",retry:"\u092a\u0941\u0928\u094d\u0939\u093e \u092a\u094d\u0930\u092f\u0924\u094d\u0928 \u0915\u0930\u093e",close:"\u092c\u0902\u0926 \u0915\u0930\u093e",copy:"\u0915\u0949\u092a\u0940 \u0915\u0930\u093e",copied:"\u0915\u0949\u092a\u0940 \u0915\u0947\u0932\u0947",share:"\u0936\u0947\u0905\u0930 \u0915\u0930\u093e",viewAll:"\u0938\u0930\u094d\u0935 \u092a\u0939\u093e",offlineNotice:"\u0924\u0941\u092e\u094d\u0939\u0940 \u0911\u092b\u0932\u093e\u0907\u0928 \u0906\u0939\u093e\u0924. \u0938\u094d\u0925\u093e\u0928\u093f\u0915 \u0915\u093e\u092f\u0926\u0947\u0936\u0940\u0930 \u092e\u093e\u0939\u093f\u0924\u0940 \u0935 \u0906\u092a\u0924\u094d\u0915\u093e\u0932\u0940\u0928 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0938\u0915\u094d\u0930\u093f\u092f \u0906\u0939\u0947\u0924.",disclaimer:"\u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0915\u093e\u092f\u0926\u0947\u0936\u0940\u0930 \u092e\u093e\u0939\u093f\u0924\u0940, \u092c\u093e\u0930 \u0915\u094c\u0928\u094d\u0938\u093f\u0932 \u0928\u093f\u092f\u092e\u093e\u0902\u0928\u0941\u0938\u093e\u0930 \u0905\u0927\u093f\u0915\u0943\u0924 \u0935