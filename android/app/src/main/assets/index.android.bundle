__d(function(e,i,t,n,r,a,o){r.exports={source:"Official Legal Glossary, Legislative Department, Ministry of Law and Justice, Government of India",lastUpdated:"2024-07-01",reviewStatus:"UNREVIEWED",notes:"TODO: Standardized terminology sourced from official Law Ministry dictionaries; requires advocate review for local colloquial variations.",terms:[{id:"term_affidavit",letter:"A",term:"Affidavit",hi:"\u0936\u092a\u0925-\u092a\u0924\u094d\u0930",mr:"\u092a\u094d\u0930\u0924\u093f\u091c\u094d\u091e\u093e\u092a\u0924\u094d\u0930",category:"Procedural",definitionEn:"A written declaration or statement of facts confirmed by an oath or affirmation before an authorized judicial officer, notary, or magistrate.",definitionHi:"\u0915\u093f\u0938\u0940 \u0905\u0927\u093f\u0915\u0943\u0924 \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u092f\u093e \u0928\u094b\u091f\u0930\u0940 \u0915\u0947 \u0938\u092e\u0915\u094d\u0937 \u0936\u092a\u0925 \u092f\u093e \u092a\u094d\u0930\u0924\u093f\u091c\u094d\u091e\u093e\u0928 \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0924\u0925\u094d\u092f\u094b\u0902 \u0915\u093e \u0932\u093f\u0916\u093f\u0924 \u0935\u093f\u0935\u0930\u0923\u0964",definitionMr:"\u0905\u0927\u093f\u0915\u0943\u0924 \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u0915\u093f\u0902\u0935\u093e \u0928\u094b\u091f\u0930\u0940\u0938\u092e\u094b\u0930 \u092a\u094d\u0930\u0924\u093f\u091c\u094d\u091e\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0932\u093f\u0939\u0942\u0928 \u0926\u093f\u0932\u0947\u0932\u0947 \u0924\u0925\u094d\u092f\u093e\u0902\u091a\u0947 \u0928\u093f\u0935\u0947\u0926\u0928.",plainExplanationEn:"A formal written statement signed under oath declaring that the facts stated in it are true to the person's best knowledge."},{id:"term_bail",letter:"B",term:"Bail",hi:"\u091c\u093c\u092e\u093e\u0928\u0924",mr:"\u091c\u093e\u092e\u0940\u0928",category:"Criminal",definitionEn:"The temporary release of an accused person awaiting trial, sometimes on condition that a sum of money or personal surety is lodged to guarantee their appearance in court.",definitionHi:"\u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u092e\u0947\u0902 \u092a\u0947\u0936 \u0939\u094b\u0928\u0947 \u0915\u0940 \u0917\u093e\u0930\u0902\u091f\u0940 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092e\u0941\u091a\u0932\u0915\u093e \u092f\u093e \u091c\u092e\u093e\u0928\u0924\u0926\u093e\u0930 \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0936\u0930\u094d\u0924 \u092a\u0930 \u0905\u092d\u093f\u092f\u0941\u0915\u094d\u0924 \u0915\u0940 \u0905\u0938\u094d\u0925\u093e\u092f\u0940 \u0930\u093f\u0939\u093e\u0908\u0964",definitionMr:"\u0916\u091f\u0932\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u0938\u0941\u0928\u093e\u0935\u0923\u0940\u0938 \u0939\u091c\u0930 \u0930\u093e\u0939\u0923\u094d\u092f\u093e\u091a\u0940 \u0939\u092e\u0940 \u0926\u0947\u090a\u0928 \u0906\u0930\u094b\u092a\u0940\u0938 \u0924\u093e\u0924\u094d\u092a\u0941\u0930\u0924\u0940 \u092e\u093f\u0933\u093e\u0932\u0947\u0932\u0940 \u092e\u0941\u0915\u094d\u0924\u0924\u093e.",plainExplanationEn:"Getting released from police or jail custody while the criminal case is pending, promising to attend court on every date."},{id:"term_cognizable",letter:"C",term:"Cognizable Offence",hi:"\u0938\u0902\u091c\u094d\u091e\u0947\u092f \u0905\u092a\u0930\u093e\u0927",mr:"\u0926\u0916\u0932\u092a\u093e\u0924\u094d\u0930 \u0917\u0941\u0928\u094d\u0939\u093e",category:"Criminal",definitionEn:"An offence in which a police officer may, in accordance with the First Schedule or under any other law, arrest without warrant and must register an FIR.",definitionHi:"\u0910\u0938\u093e \u0917\u0902\u092d\u0940\u0930 \u0905\u092a\u0930\u093e\u0927 \u091c\u093f\u0938\u092e\u0947\u0902 \u092a\u0941\u0932\u093f\u0938 \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u092c\u093f\u0928\u093e \u092e\u091c\u093f\u0938\u094d\u091f\u094d\u0930\u0947\u091f \u0915\u0947 \u0935\u093e\u0930\u0902\u091f \u0915\u0947 \u0917\u093f\u0930\u092b\u094d\u0924\u093e\u0930 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948 \u0914\u0930 \u090f\u092b\u0906\u0908\u0906\u0930 \u0926\u0930\u094d\u091c \u0915\u0930\u0928\u093e \u0905\u0928\u093f\u0935\u093e\u0930\u094d\u092f \u0939\u094b\u0924\u093e \u0939\u0948\u0964",definitionMr:"\u0905\u0938\u093e \u0917\u0902\u092d\u0940\u0930 \u0917\u0941\u0928\u094d\u0939\u093e \u091c\u094d\u092f\u093e\u092e\u0927\u094d\u092f\u0947 \u092a\u094b\u0932\u0940\u0938 \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u0935\u0949\u0930\u0902\u091f\u0936\u093f\u0935\u093e\u092f \u0905\u091f\u0915 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e\u0924 \u0906\u0923\u093f \u090f\u092b\u0906\u092f\u0906\u0930 \u0928\u094b\u0902\u0926\u0935\u0923\u0947 \u0905\u0928\u093f\u0935\u093e\u0930\u094d\u092f \u0905\u0938\u0924\u0947.",plainExplanationEn:"Serious crimes (like theft, murder, rape) where police have direct statutory authority to register a case and make an arrest immediately."},{id:"term_decree",letter:"D",term:"Decree",hi:"\u0921\u093f\u0915\u094d\u0930\u0940 (\u0939\u0941\u0915\u094d\u092e\u0928\u093e\u092e\u093e)",mr:"\u0939\u0941\u0915\u0942\u092e\u0928\u093e\u092e\u093e",category:"Civil",definitionEn:"The formal expression of an adjudication which conclusively determines the rights of the parties with regard to all or any of the matters in controversy in the suit.",definitionHi:"\u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u0928\u093f\u0930\u094d\u0923\u092f \u0915\u0940 \u0914\u092a\u091a\u093e\u0930\u093f\u0915 \u0905\u092d\u093f\u0935\u094d\u092f\u0915\u094d\u0924\u093f \u091c\u094b \u092e\u0941\u0915\u0926\u092e\u0947 \u092e\u0947\u0902 \u092a\u0915\u094d\u0937\u094b\u0902 \u0915\u0947 \u0905\u0927\u093f\u0915\u093e\u0930\u094b\u0902 \u0915\u093e \u0905\u0902\u0924\u093f\u092e \u0928\u093f\u0930\u094d\u0927\u093e\u0930\u0923 \u0915\u0930\u0924\u0940 \u0939\u0948\u0964",definitionMr:"\u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f\u093e\u0928\u0947 \u0926\u093f\u0932\u0947\u0932\u093e \u0905\u0938\u093e \u0905\u0927\u093f\u0915\u0943\u0924 \u0905\u0902\u0924\u093f\u092e \u0928\u093f\u0930\u094d\u0923\u092f \u091c\u094d\u092f\u093e\u092e\u0941\u0933\u0947 \u0926\u093e\u0935\u094d\u092f\u093e\u0924\u0940\u0932 \u092a\u0915\u094d\u0937\u093e\u0902\u091a\u0947 \u0939\u0915\u094d\u0915 \u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0939\u094b\u0924\u093e\u0924.",plainExplanationEn:"The final formal judgment of a civil court that legally settles the rights of the parties involved."},{id:"term_fir",letter:"F",term:"First Information Report (FIR)",hi:"\u092a\u094d\u0930\u0925\u092e \u0938\u0942\u091a\u0928\u093e \u0930\u093f\u092a\u094b\u0930\u094d\u091f (\u090f\u092b\u0906\u0908\u0906\u0930)",mr:"\u092a\u094d\u0930\u0925\u092e \u092e\u093e\u0939\u093f\u0924\u0940 \u0905\u0939\u0935\u093e\u0932 (\u090f\u092b\u0906\u092f\u0906\u0930)",category:"Criminal",definitionEn:"The information recorded under Section 173 of BNSS (Section 154 CrPC) relating to the commission of a cognizable offence by an officer in charge of a police station.",definitionHi:"\u0938\u0902\u091c\u094d\u091e\u0947\u092f \u0905\u092a\u0930\u093e\u0927 \u0915\u0940 \u0938\u0942\u091a\u0928\u093e \u092e\u093f\u0932\u0928\u0947 \u092a\u0930 \u092a\u0941\u0932\u093f\u0938 \u0938\u094d\u091f\u0947\u0936\u0928 \u0915\u0947 \u092a\u094d\u0930\u092d\u093e\u0930\u0940 \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u0926\u094d\u0935\u093e\u0930\u093e \u0926\u0930\u094d\u091c \u0915\u0940 \u0917\u0908 \u092a\u0939\u0932\u0940 \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u0932\u093f\u0916\u093f\u0924 \u0930\u093f\u092a\u094b\u0930\u094d\u091f\u0964",definitionMr:"\u0926\u0916\u0932\u092a\u093e\u0924\u094d\u0930 \u0917\u0941\u0928\u094d\u0939\u094d\u092f\u093e\u092c\u093e\u092c\u0924 \u092a\u094b\u0932\u0940\u0938 \u0920\u093e\u0923\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u092a\u094d\u0930\u092e\u0941\u0916\u093e\u0928\u0947 \u0928\u094b\u0902\u0926\u0935\u0932\u0947\u0932\u0940 \u092a\u0939\u093f\u0932\u0940 \u0905\u0927\u093f\u0915\u0943\u0924 \u0932\u0947\u0916\u0940 \u0924\u0915\u094d\u0930\u093e\u0930.",plainExplanationEn:"The official document prepared by police when they first receive information about a cognizable crime, starting criminal investigation."},{id:"term_habeas_corpus",letter:"H",term:"Habeas Corpus",hi:"\u092c\u0902\u0926\u0940 \u092a\u094d\u0930\u0924\u094d\u092f\u0915\u094d\u0937\u0940\u0915\u0930\u0923",mr:"\u092c\u0902\u0926\u0940 \u092a\u094d\u0930\u0924\u094d\u092f\u0915\u094d\u0937\u0940\u0915\u0930\u0923",category:"Constitutional",definitionEn:"A constitutional writ requiring a person under detention to be brought before a judge or court, especially to secure the person's release unless lawful grounds are shown for their detention.",definitionHi:"\u0938\u0902\u0935\u0948\u0927\u093e\u0928\u093f\u0915 \u0930\u093f\u091f \u091c\u093f\u0938\u0915\u0947 \u0924\u0939\u0924 \u0917\u0948\u0930\u0915\u093e\u0928\u0942\u0928\u0940 \u0930\u0942\u092a \u0938\u0947 \u0939\u093f\u0930\u093e\u0938\u0924 \u092e\u0947\u0902 \u0932\u093f\u090f \u0917\u090f \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0915\u094b \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u0938\u092e\u0915\u094d\u0937 \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u0930\u0928\u0947 \u0915\u093e \u0906\u0926\u0947\u0936 \u0926\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",definitionMr:"\u092c\u0947\u0915\u093e\u092f\u0926\u0947\u0936\u0940\u0930\u092a\u0923\u0947 \u0921\u093e\u0902\u092c\u0942\u0928 \u0920\u0947\u0935\u0932\u0947\u0932\u094d\u092f\u093e \u0935\u094d\u092f\u0915\u094d\u0924\u0940\u0932\u093e \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f\u093e\u0938\u092e\u094b\u0930 \u0939\u091c\u0930 \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u093e \u0909\u091a\u094d\u091a \u0915\u093f\u0902\u0935\u093e \u0938\u0930\u094d\u0935\u094b\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f\u093e\u0928\u0947 \u0926\u093f\u0932\u0947\u0932\u093e \u0906\u0926\u0947\u0936.",plainExplanationEn:"An emergency constitutional writ ordering authorities to produce an illegally detained person before the court."},{id:"term_injunction",letter:"I",term:"Injunction",hi:"\u0935\u094d\u092f\u093e\u0926\u0947\u0936 (\u0938\u094d\u091f\u0947 \u0906\u0930\u094d\u0921\u0930)",mr:"\u092e\u0928\u093e\u0908 \u0939\u0941\u0915\u0942\u092e",category:"Civil",definitionEn:"A judicial order that restrains a person from beginning or continuing an action threatening or invading the legal right of another.",definitionHi:"\u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u093e \u090f\u0915 \u0906\u0926\u0947\u0936 \u091c\u094b \u0915\u093f\u0938\u0940 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0915\u094b \u0915\u093f\u0938\u0940 \u0915\u093e\u0930\u094d\u092f \u0915\u094b \u0915\u0930\u0928\u0947 \u0938\u0947 \u0930\u094b\u0915\u0924\u093e \u0939\u0948 \u092f\u093e \u092f\u0925\u093e\u0938\u094d\u0925\u093f\u0924\u093f \u092c\u0928\u093e\u090f \u0930\u0916\u0928\u0947 \u0915\u093e \u0928\u093f\u0930\u094d\u0926\u0947\u0936 \u0926\u0947\u0924\u093e \u0939\u0948\u0964",definitionMr:"\u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f\u093e\u0928\u0947 \u0926\u093f\u0932\u0947\u0932\u093e \u0905\u0938\u093e \u0924\u093e\u0924\u094d\u092a\u0941\u0930\u0924\u093e \u0915\u093f\u0902\u0935\u093e \u0915\u093e\u092f\u092e\u0938\u094d\u0935\u0930\u0942\u092a\u0940 \u0906\u0926\u0947\u0936 \u091c\u094b \u090f\u0916\u093e\u0926\u094d\u092f\u093e\u0932\u093e \u0935\u093f\u0936\u093f\u0937\u094d\u091f \u0915\u0943\u0924\u0940 \u0915\u0930\u0923\u094d\u092f\u093e\u092a\u093e\u0938\u0942\u0928 \u0925\u093e\u0902\u092c\u0935\u0924\u094b.",plainExplanationEn:"A court order commonly called a stay order that prevents someone from doing a particular act (like demolishing a building or selling property)."},{id:"term_jurisdiction",letter:"J",term:"Jurisdiction",hi:"\u0905\u0927\u093f\u0915\u093e\u0930-\u0915\u094d\u0937\u0947\u0924\u094d\u0930",mr:"\u0905\u0927\u093f\u0915\u093e\u0930\u0915\u094d\u0937\u0947\u0924\u094d\u0930",category:"Procedural",definitionEn:"The official power to make legal decisions and judgments exercised by a particular court over a geographical area or subject matter.",definitionHi:"\u0915\u093f\u0938\u0940 \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u093e \u092d\u094c\u0917\u094b\u0932\u093f\u0915 \u092f\u093e \u0935\u093f\u0937\u092f\u0917\u0924 \u0938\u0940\u092e\u093e \u091c\u093f\u0938\u0915\u0947 \u092d\u0940\u0924\u0930 \u0909\u0938\u0947 \u0928\u094d\u092f\u093e\u092f\u0928\u093f\u0930\u094d\u0923\u092f \u0926\u0947\u0928\u0947 \u0915\u0940 \u0935\u0948\u0927\u093e\u0928\u093f\u0915 \u0936\u0915\u094d\u0924\u093f \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964",definitionMr:"\u0935\u093f\u0936\u093f\u0937\u094d\u091f \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u093f\u0902\u0935\u093e \u0905\u0927\u093f\u0915\u093e\u0931\u094d\u092f\u093e\u091a\u0940 \u0915\u093e\u092f\u0926\u094d\u092f\u093e\u0928\u0941\u0938\u093e\u0930 \u0916\u091f\u0932\u093e \u091a\u093e\u0932\u0935\u0923\u094d\u092f\u093e\u091a\u0940 \u0906\u0923\u093f \u0928\u093f\u0930\u094d\u0923\u092f \u0926\u0947\u0923\u094d\u092f\u093e\u091a\u0940 \u092d\u094c\u0917\u094b\u0932\u093f\u0915 \u0935 \u0915\u093e\u092f\u0926\u0947\u0936\u0940\u0930 \u0915\u0915\u094d\u0937\u093e.",plainExplanationEn:"The territorial or legal authority of a specific court or police station to handle a particular case."},{id:"term_lok_adalat",letter:"L",term:"Lok Adalat",hi:"\u0932\u094b\u0915 \u0905\u0926\u093e\u0932\u0924",mr:"\u0932\u094b\u0915 \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f",category:"Procedural",definitionEn:"A statutory forum established under the Legal Services Authorities Act, 1987 for amicable and speedy settlement of pending or pre-litigation disputes.",definitionHi:"\u0935\u093f\u0927\u093f\u0915 \u0938\u0947\u0935\u093e \u092a\u094d\u0930\u093e\u0927\u093f\u0915\u0930\u0923 \u0905\u0927\u093f\u0928\u093f\u092f\u092e \u0915\u0947 \u0905\u0902\u0924\u0930\u094d\u0917\u0924 \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u090f\u0915 \u092e\u0902\u091a \u091c\u0939\u093e\u0902 \u0932\u0902\u092c\u093f\u0924 \u092f\u093e \u0935\u093f\u0935\u093e\u0926-\u092a\u0942\u0930\u094d\u0935 \u092e\u093e\u092e\u0932\u094b\u0902 \u0915\u093e \u0906\u092a\u0938\u0940 \u0938\u092e\u091d\u094c\u0924\u0947 \u0938\u0947 \u0924\u094d\u0935\u0930\u093f\u0924 \u0928\u093f\u092a\u091f\u093e\u0930\u093e \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",definitionMr:"\u0915\u093e\u092f\u0926\u0947\u0936\u0940\u0930 \u0938\u0947\u0935\u093e \u092a\u094d\u0930\u093e\u0927\u093f\u0915\u0930\u0923 \u0915\u093e\u092f\u0926\u094d\u092f\u093e\u0902\u0924\u0930\u094d\u0917\u0924 \u092a\u094d\u0930\u0932\u0902\u092c\u093f\u0924 \u0916\u091f\u0932\u094d\u092f\u093e\u0902\u091a\u093e \u092a\u0930\u0938\u094d\u092a\u0930 \u0938\u0939\u092e\u0924\u0940\u0928\u0947 \u091c\u0932\u0926 \u0928\u093f\u092a\u091f\u093e\u0930\u093e \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0938\u094d\u0925\u093e\u092a\u0928 \u0915\u0947\u0932\u0947\u0932\u0947 \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f.",plainExplanationEn:"A people's court organized by legal aid authorities to resolve disputes peacefully and quickly without appealable court fees."},{id:"term_non_bailable",letter:"N",term:"Non-Bailable Offence",hi:"\u0917\u0948\u0930-\u091c\u092e\u093e\u0928\u0924\u0940 \u0905\u092a\u0930\u093e\u0927",mr:"\u0905\u091c\u093e\u092e\u0940\u0928\u092a\u093e\u0924\u094d\u0930 \u0917\u0941\u0928\u094d\u0939\u093e",category:"Criminal",definitionEn:"An offence in which bail is not a matter of right for the accused, but lies in the sound judicial discretion of the court.",definitionHi:"\u0910\u0938\u093e \u0905\u092a\u0930\u093e\u0927 \u091c\u093f\u0938\u092e\u0947\u0902 \u091c\u092e\u093e\u0928\u0924 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u093e \u0905\u0927\u093f\u0915\u093e\u0930 \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u093e, \u092c\u0932\u094d\u0915\u093f \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u0928\u094d\u092f\u093e\u092f\u093f\u0915 \u0935\u093f\u0935\u0947\u0915 \u092a\u0930 \u0928\u093f\u0930\u094d\u092d\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",definitionMr:"\u0905\u0938\u093e \u0917\u0941\u0928\u094d\u0939\u093e \u091c\u094d\u092f\u093e\u092e\u0927\u094d\u092f\u0947 \u091c\u093e\u092e\u0940\u0928 \u092e\u093f\u0933\u0923\u0947 \u0939\u093e \u0915\u093e\u092f\u0926\u0947\u0936\u0940\u0930 \u0939\u0915\u094d\u0915 \u0928\u0938\u0942\u0928 \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f\u093e\u091a\u094d\u092f\u093e \u0935\u093f\u0935\u0947\u0915\u093e\u0928\u0941\u0938\u093e\u0930 \u0926\u093f\u0932\u093e \u091c\u093e\u0924\u094b.",plainExplanationEn:"An offense where police cannot release you on station bail; only a judicial magistrate or judge can decide whether to grant bail."},{id:"term_perjury",letter:"P",term:"Perjury",hi:"\u092e\u093f\u0925\u094d\u092f\u093e \u0938\u093e\u0915\u094d\u0937\u094d\u092f (\u091d\u0942\u0920\u0940 \u0917\u0935\u093e\u0939\u0940)",mr:"\u0916\u094b\u091f\u0940 \u0938\u093e\u0915\u094d\u0937",category:"Criminal",definitionEn:"The offence of wilfully telling an untruth or making a misrepresentation in a court of law after having taken an oath or affirmation.",definitionHi:"\u0936\u092a\u0925 \u0932\u0947\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u092e\u0947\u0902 \u091c\u093e\u0928\u092c\u0942\u091d\u0915\u0930 \u091d\u0942\u0920\u093e \u092c\u092f\u093e\u0928 \u0926\u0947\u0928\u093e \u092f\u093e \u091d\u0942\u0920\u0940 \u0917\u0935\u093e\u0939\u0940 \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u0930\u0928\u093e\u0964",definitionMr:"\u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f\u093e\u0924 \u0936\u092a\u0925 \u0918\u0947\u0924\u0932\u094d\u092f\u093e\u0928\u0902\u0924\u0930 \u091c\u093e\u0923\u0942\u0928\u092c\u0941\u091c\u0942\u0928 \u0916\u094b\u091f\u0940 \u092e\u093e\u0939\u093f\u0924\u0940 \u0915\u093f\u0902\u0935\u093e \u0938\u093e\u0915\u094d\u0937 \u0926\u0947\u0923\u0947.",plainExplanationEn:"The crime of lying under oath in court proceedings."},{id:"term_quash",letter:"Q",term:"Quash",hi:"\u0930\u0926\u094d\u0926 \u0915\u0930\u0928\u093e (\u0916\u093e\u0930\u093f\u091c \u0915\u0930\u0928\u093e)",mr:"\u0930\u0926\u094d\u0926\u092c\u093e\u0924\u0932 \u0915\u0930\u0923\u0947",category:"Procedural",definitionEn:"To officially void, invalidate, or set aside a criminal proceeding, FIR, or order, typically under inherent powers of the High Court (Section 528 BNSS / Section 482 CrPC).",definitionHi:"\u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u0905\u0902\u0924\u0930\u094d\u0928\u093f\u0939\u093f\u0924 \u0936\u0915\u094d\u0924\u093f\u092f\u094b\u0902 \u0915\u0947 \u0924\u0939\u0924 \u0915\u093f\u0938\u0940 \u0905\u0935\u0948\u0927 \u090f\u092b\u0906\u0908\u0906\u0930, \u091a\u093e\u0930\u094d\u091c\u0936\u0940\u091f \u092f\u093e \u0906\u0926\u0947\u0936 \u0915\u094b \u092a\u0942\u0930\u094d\u0923\u0924\u0903 \u0928\u093f\u0930\u0938\u094d\u0924 \u0915\u0930\u0928\u093e\u0964",definitionMr:"\u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f\u093e\u091a\u094d\u092f\u093e \u0905\u0927\u093f\u0915\u093e\u0930\u093e\u0902\u0924\u0930\u094d\u0917\u0924 \u090f\u0916\u093e\u0926\u093e \u092c\u0947\u0915\u093e\u092f\u0926\u0947\u0936\u0940\u0930 \u090f\u092b\u0906\u092f\u0906\u0930, \u0906\u0930\u094b\u092a\u092a\u0924\u094d\u0930 \u0915\u093f\u0902\u0935\u093e \u0906\u0926\u0947\u0936 \u092a\u0942\u0930\u094d\u0923\u092a\u0923\u0947 \u0930\u0926\u094d\u0926 \u0915\u0930\u0923\u0947.",plainExplanationEn:"When a High Court completely terminates an unfair, illegal, or abusive FIR or trial before it proceeds further."},{id:"term_sub_judice",letter:"S",term:"Sub Judice",hi:"\u0928\u094d\u092f\u093e\u092f\u093e\u0927\u0940\u0928 \u092e\u093e\u092e\u0932\u093e",mr:"\u0928\u094d\u092f\u093e\u092f\u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u092c\u093e\u092c",category:"Procedural",definitionEn:"A Latin term signifying a matter under judicial consideration and therefore prohibited from public discussion or prejudice elsewhere.",definitionHi:"\u0910\u0938\u093e \u092e\u093e\u092e\u0932\u093e \u091c\u094b \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u0947\u0902 \u0915\u093f\u0938\u0940 \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u092e\u0947\u0902 \u0935\u093f\u091a\u093e\u0930\u093e\u0927\u0940\u0928 \u0939\u0948 \u0914\u0930 \u091c\u093f\u0938 \u092a\u0930 \u0938\u093e\u0930\u094d\u0935\u091c\u0928\u093f\u0915 \u091f\u093f\u092a\u094d\u092a\u0923\u0940 \u0935\u0930\u094d\u091c\u093f\u0924 \u0939\u0948\u0964",definitionMr:"\u0938\u0927\u094d\u092f\u093e \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f\u093e\u0924 \u091a\u093e\u0932\u0942 \u0905\u0938\u0932\u0947\u0932\u093e \u0916\u091f\u0932\u093e \u091c\u094d\u092f\u093e\u0935\u0930 \u0938\u093e\u0930\u094d\u0935\u091c\u0928\u093f\u0915 \u092a\u0942\u0930\u094d\u0935\u0917\u094d\u0930\u0939\u0926\u0942\u0937\u093f\u0924 \u091a\u0930\u094d\u091a\u093e \u0915\u0930\u0923\u094d\u092f\u093e\u0938 \u092e\u0928\u093e\u0908 \u0905\u0938\u0924\u0947.",plainExplanationEn:"A case that is currently being heard by a court, meaning people should not publicly influence or judge the outcome."},{id:"term_vakalatnama",letter:"V",term:"Vakalatnama",hi:"\u0935\u0915\u093e\u0932\u0924\u0928\u093e\u092e\u093e",mr:"\u0935\u0915\u093f\u0932\u0940\u092a\u0924\u094d\u0930",category:"Procedural",definitionEn:"A written legal document by which a client authorizes an advocate to represent and act on their behalf before a court of law.",definitionHi:"\u090f\u0915 \u0932\u093f\u0916\u093f\u0924 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c \u091c\u093f\u0938\u0915\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u0915\u094b\u0908 \u092e\u0941\u0935\u0915\u094d\u0915\u093f\u0932 \u0915\u093f\u0938\u0940 \u0905\u0927\u093f\u0935\u0915\u094d\u0924\u093e \u0915\u094b \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u092e\u0947\u0902 \u0905\u092a\u0928\u0940 \u0913\u0930 \u0938\u0947 \u0909\u092a\u0938\u094d\u0925\u093f\u0924 \u0939\u094b\u0928\u0947 \u0914\u0930 \u092e\u0941\u0915\u0926\u092e\u093e \u0932\u0921\u093c\u0928\u0947 \u0915\u093e \u0905\u0927\u093f\u0915\u093e\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964",definitionMr:"\u092a\u0915\u094d\u0937\u0915\u093e\u0930\u093e\u0928\u0947 \u0906\u092a\u0932\u094d\u092f\u093e \u092c\u093e\u091c\u0942\u0928\u0947 \u0916\u091f\u0932\u093e \u0932\u0922\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0935\u0915\u093f\u0932\u093e\u0932\u093e \u0926\u093f\u0932\u0947\u0932\u0947 \u0905\u0927\u093f\u0915\u0943\u0924 \u0915\u093e\u092f\u0926\u0947\u0936\u0940\u0930 \u0905\u0927\u093f\u0915\u093e\u0930\u092a\u0924\u094d\u0930.",plainExplanationEn:"A power of attorney document that an advocate files in court showing they represent you in that case."},{id:"term_zero_fir",letter:"Z",term:"Zero FIR",hi:"\u0936\u0942\u0928\u094d\u092f \u090f\u092b\u0906\u0908\u0906\u0930",mr:"\u091d\u093f\u0930\u094b \u090f\u092b\u0906\u092f\u0906\u0930",category:"Criminal",definitionEn:"An FIR registered at any police station irrespective of territorial jurisdiction, marked with number 0 and transferred to the jurisdictional station for investigation.",definitionHi:"\u0915\u094d\u0937\u0947\u0924\u094d\u0930\u093e\u0927\u093f\u0915\u093e\u0930 \u0915\u0940 \u092a\u0930\u0935\u093e\u0939 \u0915\u093f\u090f \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u092d\u0940 \u092a\u0941\u0932\u093f\u0938 \u0938\u094d\u091f\u0947\u0936\u0928 \u092e\u0947\u0902 \u0926\u0930\u094d\u091c \u0915\u0940 \u091c\u093e\u0928\u0